//@version=6
// ════════════════════════════════════════════════════════════════════════════
// JW_Foundation — ط0: نطاقات الموجة النقيّة (rangeHiLo/rangeDays + حارس MAX_HIST) — v4: محرّك leg حُذف (النقلة 3)
//   مُستخرَجة من J-Waves M2 (فرع rebuild-from-scratch) وفق docs/build/spec_lib_JW_Foundation.md
//   المبدأ: كور نقيّ بلا input/رسم؛ الرسم واللوحة والمدخلات تبقى في المؤشّر المستهلِك.
//   OHLC/time بالإزاحة تعمل داخل المكتبة (v6).
// ════════════════════════════════════════════════════════════════════════════
library("JW_Foundation", overlay = true)

// نافذة التاريخ المضمونة (< max_bars_back=5000 في المستهلِك) — مصدر حقيقة واحد لحارس الـbuffer عبر كلّ الدوالّ.
//   🔴 يتطلّب المستهلِك: max_bars_back ≥ MAX_HIST+1.
int MAX_HIST = 4900

// ─────────────────────────────────────────────────────────────────────────────
// 1) دوالّ نقيّة
// ─────────────────────────────────────────────────────────────────────────────

// أعلى/أدنى سعر ضمن نطاق بارات [leftB..rightB]. حارس buffer: يُقيَّد الطرف الأيسر بنافذة
// التاريخ المضمونة (bar_index-4900 < max_bars_back)؛ نطاق أقدم كليًّا ⇒ na (يُتخطّى، لا crash).
export rangeHiLo(int leftB, int rightB) =>
    float hi = na
    float lo = na
    int safeLeft = na(leftB) ? na : math.max(leftB, bar_index - MAX_HIST)
    if not na(safeLeft) and not na(rightB) and rightB >= safeLeft
        for j = safeLeft to rightB
            int off = bar_index - j
            if off >= 0
                hi := na(hi) or high[off] > hi ? high[off] : hi
                lo := na(lo) or low[off] < lo ? low[off] : lo
    [hi, lo]

// زمن نطاق بارات [leftB..rightB] بالأيّام. حارس buffer (مطابق rangeHiLo): طرف أقدم من نافذة MAX_HIST
//   أو مدخلات مقلوبة/na ⇒ na (المستهلك يعرض «—»)، لا وصول بإزاحة تتجاوز max_bars_back ⇒ لا crash.
export rangeDays(int leftB, int rightB) =>
    float r = na
    if not na(leftB) and not na(rightB) and rightB >= leftB and rightB <= bar_index and (bar_index - leftB) <= MAX_HIST
        r := (time[bar_index - rightB] - time[bar_index - leftB]) / 86400000.0
    r

// ─────────────────────────────────────────────────────────────────────────────
// [v4 · النقلة 3] محرّك leg حُذف كاملًا (LegEngine · newLegEngine · legInputs · legStep) ومعه waveLeftStruct وwaveLen
//   (صفر مستدعين منذ المحرّك الأماميّ م2-3): حدود الموجات كلّها من سلسلة الانقلابات، والكبيرة بالكسر من المتوسطة
//   باتجاه كلّ موجة، والاتجاه البنيويّ curWdir0 حلّ محلّ هيستيريسيس bigDir — فمات waveScaleDays=21 الملفّق نهائيًّا.
//   بقيت المكتبة نطاقاتٍ نقيّةً: rangeHiLo + rangeDays (+ حارس MAX_HIST).
// ─────────────────────────────────────────────────────────────────────────────
