//@version=6
// ════════════════════════════════════════════════════════════════════════════
// JW_Foundation — ط0: leg + الموجة التاريخيّة (النواة النقيّة)
//   مُستخرَجة من J-Waves M2 (فرع rebuild-from-scratch) وفق docs/build/spec_lib_JW_Foundation.md
//   المبدأ: كور نقيّ بلا input/رسم؛ الرسم واللوحة والمدخلات تبقى في المؤشّر المستهلِك.
//   الحالة كلّها في LegEngine (مصدر واحد، لا var داخل دوالّ مُصدَّرة). OHLC/time بالإزاحة تعمل داخل المكتبة (v6).
// ════════════════════════════════════════════════════════════════════════════
library("JW_Foundation", overlay = true)

// ─────────────────────────────────────────────────────────────────────────────
// 1) دوالّ نقيّة
// ─────────────────────────────────────────────────────────────────────────────

// طول الموجة اليدويّ مقيَّدًا ضمن المدى الصالح.
export waveLen(int nBars) =>
    math.min(math.max(nBars, 1), bar_index + 1)

// أعلى/أدنى سعر ضمن نطاق بارات [leftB..rightB]. حارس buffer: يُقيَّد الطرف الأيسر بنافذة
// التاريخ المضمونة (bar_index-4900 < max_bars_back)؛ نطاق أقدم كليًّا ⇒ na (يُتخطّى، لا crash).
export rangeHiLo(int leftB, int rightB) =>
    float hi = na
    float lo = na
    int safeLeft = na(leftB) ? na : math.max(leftB, bar_index - 4900)
    if not na(safeLeft) and not na(rightB) and rightB >= safeLeft
        for j = safeLeft to rightB
            int off = bar_index - j
            if off >= 0
                hi := na(hi) or high[off] > hi ? high[off] : hi
                lo := na(lo) or low[off] < lo ? low[off] : lo
    [hi, lo]

// زمن نطاق بارات [leftB..rightB] بالأيّام.
export rangeDays(int leftB, int rightB) =>
    (time[bar_index - rightB] - time[bar_index - leftB]) / 86400000.0

// ─────────────────────────────────────────────────────────────────────────────
// 2) محرّك الـleg (كلّ الحالة في UDT — كنمط DegreeLaws/BreakProc)
// ─────────────────────────────────────────────────────────────────────────────
export type LegEngine
    int   dir0                                        // اتجاه الساق الجارية (0=غير مبذور)
    int   swC                                         // عدّاد شموع الساق (يكبح السيقان الصغيرة)
    float extHi                                        // تطرّف القمّة الجاري
    int   extHiBar
    float extLo                                        // تطرّف القاع الجاري
    int   extLoBar
    array<int>   bars                                  // حدود الموجات (مواضع التطرّفات المؤكَّدة)
    array<float> ps                                    // أسعار الحدود
    array<bool>  tops                                  // نوع الحدّ: قمّة(true)/قاع(false)
    int   bigDir                                       // اتجاه الموجة العامّ (هيستيريسيس) — يستهلكه المؤشّر لكلّ الطبقات

// باني: حالة صفريّة + مصفوفات فارغة (يُنادى مرّةً بـ var في المؤشّر).
export newLegEngine() =>
    LegEngine.new(0, 0, na, na, na, na, array.new<int>(), array.new<float>(), array.new<bool>(), 0)

// مدخلات المحرّك (ta.* + هيستيريسيس bigDir) — ⚠️ تُستدعى كلّ بار **بلا شرط** (ta.* تفسد تاريخها
//   لو نُودِيت داخل شرط). تُحدِّث self.bigDir وتُرجِع [legTh (عتبة الـleg), bigDir]. السعة زمنيّة (جلسة الأداة).
export legInputs(LegEngine self, float waveScaleDays, float legMinRatio) =>
    int   lookB      = math.min(bar_index, 200)                                   // نافذة تقدير شموع-اليوم
    float spanMs     = lookB > 0 ? (time - time[lookB]) : na                      // المدّة التقويميّة الفعليّة
    float barsPerDay = (not na(spanMs) and spanMs > 0) ? (lookB * 86400000.0 / spanMs) : (86400.0 / timeframe.in_seconds())
    int   ampBars    = math.min(4900, math.max(50, int(math.round(waveScaleDays * barsPerDay))))   // الموجة ~waveScaleDays يومًا
    float ampHist    = ta.highest(high, ampBars) - ta.lowest(low, ampBars)        // سعة مرجعيّة (مقياس العتبة فقط)
    float legTh      = legMinRatio * ampHist
    int   hbW        = ta.highestbars(high, ampBars)
    int   lbW        = ta.lowestbars(low, ampBars)
    int   rawDir     = hbW > lbW ? 1 : -1
    if self.bigDir == 0                                                           // هيستيريسيس: لا ينقلب إلّا بفصلٍ معتبَر
        self.bigDir := rawDir
    else if rawDir != self.bigDir and math.abs(hbW - lbW) > ampBars * 0.1
        self.bigDir := rawDir
    [legTh, self.bigDir]

// خطوة المحرّك — ⚠️ تُستدعى داخل `if barstate.isconfirmed` فقط. تُمرَّر مخرجات legInputs + الثوابت.
//   المنطق: بذر الاتجاه ⇒ تتبّع التطرّف ⇒ تثبيت حدّ موجة عند تجاوز legTh + أدنى شموع ⇒ قصّ legCap.
export legStep(LegEngine self, float legTh, int bigDir, int bigMinSwings, int legCap) =>
    if self.dir0 == 0 and bigDir != 0
        self.dir0     := bigDir
        self.extHi    := high
        self.extHiBar := bar_index
        self.extLo    := low
        self.extLoBar := bar_index
        self.swC      := 0
    if self.dir0 == 1
        self.swC := self.swC + 1
        if na(self.extHi) or high > self.extHi
            self.extHi    := high
            self.extHiBar := bar_index
        if not na(legTh) and legTh > 0 and not na(self.extHi) and low < self.extHi - legTh and self.swC >= bigMinSwings
            array.push(self.bars, self.extHiBar)      // ثبِّت القمّة كحدّ موجة، اقلب لهابط
            array.push(self.ps, self.extHi)
            array.push(self.tops, true)
            self.dir0     := -1
            self.extLo    := low
            self.extLoBar := bar_index
            self.swC      := 0
    else if self.dir0 == -1
        self.swC := self.swC + 1
        if na(self.extLo) or low < self.extLo
            self.extLo    := low
            self.extLoBar := bar_index
        if not na(legTh) and legTh > 0 and not na(self.extLo) and high > self.extLo + legTh and self.swC >= bigMinSwings
            array.push(self.bars, self.extLoBar)      // ثبِّت القاع كحدّ موجة، اقلب لصاعد
            array.push(self.ps, self.extLo)
            array.push(self.tops, false)
            self.dir0     := 1
            self.extHi    := high
            self.extHiBar := bar_index
            self.swC      := 0
    while array.size(self.bars) > legCap              // احفظ آخر ~legCap حدًّا (أداء)
        array.shift(self.bars)
        array.shift(self.ps)
        array.shift(self.tops)
    self.dir0

// ─────────────────────────────────────────────────────────────────────────────
// 3) يسار الموجة + بناء مقاطع التحليل (نقيّة، من الحالة — بلا رسم)
// ─────────────────────────────────────────────────────────────────────────────

// يسار الموجة التاريخية حسب waveMode: تلقائيّ (آخر حدّ leg = أصل الساق) · يدويّ (آخر N شمعة)
//   · دمج (متوسّط الاثنين ثمّ يرسو على أقرب حدّ leg — يحافظ على الرسو).
export waveLeft(LegEngine self, string waveMode, int histBars, int autoWaveLen) =>
    int autoL = array.size(self.bars) > 0 ? array.get(self.bars, array.size(self.bars) - 1) : math.max(bar_index - autoWaveLen + 1, 0)
    int barL  = math.max(bar_index - waveLen(histBars) + 1, 0)
    int res   = autoL
    if waveMode == "Manual (candles) / يدويّ (شموع)"
        res := barL
    else if waveMode == "Combine / دمج (متوسّط)"
        int avgL = int((autoL + barL) / 2)
        int best = avgL
        int bd   = 2147483647
        if array.size(self.bars) > 0
            for i = 0 to array.size(self.bars) - 1
                int lb = array.get(self.bars, i)
                int d  = math.abs(lb - avgL)
                if d < bd
                    bd   := d
                    best := lb
        res := best
    res

// بناء مقاطع التحليل (بلا رسم): المقطع 0 = الموجة الحاليّة (دائمًا) ثمّ التواريخ = سيقان leg
//   خلف wL (تلقائيّ فقط). في وضع التاريخ اليدويّ (useHohN) لا تُبنى مقاطع تاريخ (المقطع 0 فقط)
//   — مطابقٌ للأصل (المستطيل اليدويّ عرضٌ بحت لا مقطع تحليل). المؤشّر يرسم من المصفوفات الأربع.
export buildSegments(LegEngine self, int wL, int wR, int histDepth, bool useHohN) =>
    array<int>   lefts   = array.new<int>()
    array<int>   rights  = array.new<int>()
    array<float> leftPx  = array.new<float>()
    array<bool>  leftTop = array.new<bool>()
    // المقطع 0 = الموجة الحاليّة
    array.push(lefts, wL)
    array.push(rights, wR)
    float wLpx  = na                                   // سعر طرف leg المطابق لـwL (للإرساء) · na في يدويّ
    bool  wLtop = true
    if array.size(self.bars) > 0
        for i = 0 to array.size(self.bars) - 1
            if array.get(self.bars, i) == wL
                wLpx  := array.get(self.ps, i)
                wLtop := array.get(self.tops, i)
    array.push(leftPx, wLpx)
    array.push(leftTop, wLtop)
    // التواريخ = سيقان leg خلف wL، مُرساة على بداية الموجة (لا فجوة) — تلقائيّ فقط
    if not useHohN
        int n        = array.size(self.bars)
        int rightBar = wL
        int drawn    = 0
        int li       = n - 1
        while li >= 0 and drawn < histDepth
            int legB = array.get(self.bars, li)
            if legB < rightBar and bar_index - legB <= 4900   // طرف خلف الحدّ + ضمن نافذة buffer مضمونة
                float pL = array.get(self.ps, li)
                [rh, rl] = rangeHiLo(legB, rightBar)
                if not na(rh) and not na(rl)
                    array.push(lefts, legB)            // مقطع تحليل دائمًا (لا يتأثّر بإخفاء المستطيل)
                    array.push(rights, rightBar)
                    array.push(leftPx, pL)
                    array.push(leftTop, array.get(self.tops, li))   // نوع الحدّ (مصدر الكبيرة)
                    rightBar := legB
                    drawn    := drawn + 1
            li := li - 1
    [lefts, rights, leftPx, leftTop]
