//@version=6
// ════════════════════════════════════════════════════════════════════════════
// JW_Lines — ط2: خطوط السيولة ومستويات الاتجاه (الدرس08) — الرسم النقيّ المعمّم
//   مُستخرَجة من J-Waves M2 (فرع m3/gaps-and-scale) وفق docs/build/spec_lib_JW_Lines.md
//   حسم المستخدم (2026-07-12): **مستوى الاتجاه (أفقيّ) على الأجسام · خطّ السيولة (مائل) على الذيول**.
//   معمّم لكلّ درجة: صاعد ⇒ أساس القيعان (دعم) · هابط ⇒ أساس القمم (مقاومة).
//   levelExtend وسيط (كان عالميًّا في المؤشّر). خطّ السيولة يمتدّ بشعاع extend.right (بلا وسيط مدًى، أ12). OHLC/time بالإزاحة تعمل داخل المكتبة (v6).
//   يبقى في المؤشّر (لا يُنقَل): f_activeDir (الاتجاه الفعّال، د09) · رصد الكسر (د09) · المراحل (ط3) · التنسيق.
// ════════════════════════════════════════════════════════════════════════════
library("JW_Lines", overlay = true)

// ─── ج1 [درس08]: مستوى الاتجاه — أفقيّ على **الجسم** عند آخر تطرّف فعّال من نوع الأساس ───
//   dir = الاتجاه الفعّال: هابط(-1) ⇒ آخر قمّة فعّالة (مقاومة) · صاعد ⇒ آخر قاع فعّال (دعم). على max/min(open,close). يمتدّ levelExtend شمعة.
export f_levelLine(array<int> aBar, array<bool> aTop, array<bool> aEff, array<int> aTm, color col, int w, int dir, int levelExtend) =>
    line ln = na
    bool wantTop = dir == -1
    int  li    = array.size(aBar) - 1
    int  found = -1
    while li >= 0 and found < 0
        if array.get(aEff, li) and array.get(aTop, li) == wantTop
            found := li
        li := li - 1
    if found >= 0
        int o = bar_index - array.get(aBar, found)
        if o >= 0
            float lvl = wantTop ? math.max(open[o], close[o]) : math.min(open[o], close[o])   // على الجسم (حافّة جسم القمّة/القاع) لا الذيل
            int rightTm = time + levelExtend * timeframe.in_seconds() * 1000                   // ينتهي بعد السعر الحاليّ بعدد شموع محدَّد
            ln := line.new(array.get(aTm, found), lvl, rightTm, lvl, xloc = xloc.bar_time, color = col, width = w)
    ln

// ─── ج2 [درس08]: انتقاء طرفَي خطّ السيولة — الزوج **الأحدث المجاور** المتّسق مع الاتجاه من الموجة الحيّة (عند atBar) ───
//   قاعان متصاعدان صعودًا · قمّتان متنازلتان هبوطًا؛ يستثني ما لم يتكوّن بعد (aBar>atBar).
//   [حسم 2026-07-14 · مصعب 14:33 + ق7] الزوج = الأخيران فقط (px[m-2],px[m-1]). غير متّسق ⇒ [-1,-1] (لا خطّ ⇒ عرضيّ). **لا قفز لزوج أقدم ولا ارتداد لآخر طرفين.**
export f_liqPairAt(array<int> aBar, array<bool> aTop, array<bool> aEff, int wdir, int atBar) =>
    bool wantTop = wdir == -1
    array<int>   px = array.new<int>()
    array<float> pw = array.new<float>()
    int n = array.size(aBar)
    for i = 0 to (n > 0 ? n - 1 : 0)
        if n > 0 and array.get(aEff, i) and array.get(aTop, i) == wantTop and array.get(aBar, i) <= atBar
            int o = bar_index - array.get(aBar, i)
            if o >= 0
                array.push(px, i)
                array.push(pw, wantTop ? high[o] : low[o])                // الذيل (لا الجسم)
    int m  = array.size(px)
    int r1 = -1
    int r2 = -1
    if m >= 2
        float w1 = array.get(pw, m - 2)                                  // الطرفان **الأخيران** المجاوران فقط (ق7)
        float w2 = array.get(pw, m - 1)
        if wantTop ? (w2 < w1) : (w2 > w1)                               // هابط: قمّتان متنازلتان · صاعد: قاعان متصاعدان
            r1 := array.get(px, m - 2)
            r2 := array.get(px, m - 1)
        // غير متّسق ⇒ يبقى [-1,-1] (لا خطّ) ⇒ السوق «عرضيّ». لا قفز لزوج أقدم ولا ارتداد (مصعب 14:33).
    [r1, r2]

// غلاف رفيع: التقييم عند البار الحاليّ (atBar=bar_index).
export f_liqPair(array<int> aBar, array<bool> aTop, array<bool> aEff, int wdir) =>
    [q1, q2] = f_liqPairAt(aBar, aTop, aEff, wdir, bar_index)
    [q1, q2]

// ─── ج2-ب [ط3/د11] زوج **آلة المراحل** — أحدث زوج **متّسق** (يقفز لزوج أقدم إن لزم) + ارتداد لآخر طرفين ───
//   🔴 [إصلاح انحدار v2.39.2] **لا تستعمل f_liqPairAt (ق2) لآلة المراحل:** حسم مصعب [14:33] «لا زوج متّسق ⇒ لا خطّ»
//   يخصّ **الخطّ المرسوم (ط2/د08)** لا المراحل (ط3). تطبيقه على المراحل جعل `i2` = **التطرّف المُقيَّم نفسه** ⇒
//   `lineNow = ذيله` ⇒ `midNow` لا يتجاوزه أبدًا (mid≥low) ⇒ **الكسر مستحيل رياضيًّا** ⇒ صفر إشارات درجات،
//   و`cnt≡0` ⇒ **اليأس/التجميع غير قابلَين للوصول**. المراحل تحتاج الخطّ **الذي كُسِر** (زوج أقدم متّسق) لتقيس الكسر بعده.
export f_liqPairPhaseAt(array<int> aBar, array<bool> aTop, array<bool> aEff, int wdir, int atBar) =>
    bool wantTop = wdir == -1
    array<int>   px = array.new<int>()
    array<float> pw = array.new<float>()
    int n = array.size(aBar)
    for i = 0 to (n > 0 ? n - 1 : 0)
        // 🔴 [الجذر · v2.39.3] `< atBar` **أصغر تمامًا** لا `<=`: إدخال التطرّف المُقيَّم نفسه في مرشّحي الزوج = **look-ahead**
        //   (الشمعة المُختبَرة تُعرِّف الخطّ الذي تُختبَر به) ⇒ `i2=atBar` ⇒ `lineNow`=ذيله ⇒ الكسر مستحيل رياضيًّا.
        //   بالاستثناء: `i2 < atBar` دائمًا ⇒ الكسر ممكن بلا شرط، والتقييم أمينٌ لما رآه السوق **قبل** التطرّف.
        if n > 0 and array.get(aEff, i) and array.get(aTop, i) == wantTop and array.get(aBar, i) < atBar
            int o = bar_index - array.get(aBar, i)
            if o >= 0
                array.push(px, i)
                array.push(pw, wantTop ? high[o] : low[o])                // الذيل (لا الجسم)
    int m  = array.size(px)
    int r1 = -1
    int r2 = -1
    if m >= 2
        for k = m - 1 to 1                                               // من الأحدث للأقدم: أوّل زوج متّسق
            if r2 < 0
                float w1 = array.get(pw, k - 1)
                float w2 = array.get(pw, k)
                if wantTop ? (w2 < w1) : (w2 > w1)                        // هابط: قمّتان متنازلتان · صاعد: قاعان متصاعدان
                    r1 := array.get(px, k - 1)
                    r2 := array.get(px, k)
        if r2 < 0                                                        // لا زوج متّسق ⇒ آخر طرفين (الخطّ المكسور = مرجع قياس الذعر)
            r1 := array.get(px, m - 2)
            r2 := array.get(px, m - 1)
    [r1, r2]

// ─── خطّ السيولة — مائل على **الذيول** بين الطرفين الحقيقيّين ثمّ يمتدّ يمينًا بشعاع (extend.right) ───
//   🔴 [أ11/spec_liq_pair_fix · v5] الرسم على الطرفين الحقيقيّين + extend.right — لا نقطة نهاية محسوبة.
//   الإصلاح: كانت النقطة اليمنى تُحسَب بإسقاط الميل على bar_index+liqExtend بلا أرضيّة ⇒ على زوج قمّتين
//   متجاورتين بارًا/متباعدتين سعرًا يهوي projP لسعر سالب (BTC·60: −15157) يقرؤه data_get_pine_lines.
//   الآن الإحداثيّان المخزَّنان = (aTm[i1],wp1) و(aTm[i2],wp2)، كلاهما سعر حقيقيّ موجب؛ الامتداد يمينًا
//   شعاع بصريّ يتكفّل به المحرّك بلا تجسيد إحداثيّ سالب. الميل نفسه لم يتغيّر ⇒ f_liqDir/f_liqBroken حرفيًّا.
//   liqExtend: حُذف من التوقيع (أ12) — extend.right لا يحتاجه؛ إبقاؤه وسيطًا ميّتًا يرفضه المصرّف (CE10237).
export f_liqLine(array<int> aBar, array<bool> aTop, array<bool> aEff, array<int> aTm, color col, int w, int wdir) =>
    line ln = na
    bool wantTop = wdir == -1
    [i1, i2] = f_liqPair(aBar, aTop, aEff, wdir)
    if i1 >= 0 and i2 >= 0
        int o1 = bar_index - array.get(aBar, i1)
        int o2 = bar_index - array.get(aBar, i2)
        if o1 >= 0 and o2 >= 0
            float wp1 = wantTop ? high[o1] : low[o1]                      // ذيل الطرف الأقدم
            float wp2 = wantTop ? high[o2] : low[o2]                      // ذيل الطرف الأحدث
            ln := line.new(array.get(aTm, i1), wp1, array.get(aTm, i2), wp2, xloc = xloc.bar_time, extend = extend.right, color = col, width = w)
    ln

// ─── [درس09/م1] اتجاه السيولة = ميل خطّها (عرض/تحقّق فقط، بلا ربط بالاستخراج) ───
export f_liqDir(array<int> aBar, array<bool> aTop, array<bool> aEff, int wdir) =>
    int  dir = 0
    bool wantTop = wdir == -1
    [i1, i2] = f_liqPair(aBar, aTop, aEff, wdir)
    if i1 >= 0 and i2 >= 0
        int o1 = bar_index - array.get(aBar, i1)
        int o2 = bar_index - array.get(aBar, i2)
        if o1 >= 0 and o2 >= 0
            float wp1 = wantTop ? high[o1] : low[o1]
            float wp2 = wantTop ? high[o2] : low[o2]
            dir := wp2 > wp1 ? 1 : wp2 < wp1 ? -1 : 0
    dir
