//@version=6
// ============================================================================
// JW_Confluence — جسر تقييم التلاقي لإشارات M-Waves
// ----------------------------------------------------------------------------
// 🔴 الخطّ الأحمر: النواة (M-Waves) هي المولّد الوحيد للإشارة. هذا الجسر
//    «يقرأ فقط»: يأخذ إشارةً ناجيةً من النواة + أصوات المصادر ⇒ يعيد تقييمًا
//    (نجوم توافق + veto). لا يولّد نقطة/درجة/منطقة/إشارة، ولا يعدّل أيّها.
//
// التصميم: مصفوفات متوازية (اتّجاه/قوّة/حسم لكلّ مصدر) بدل UDT ⇒ يتفادى فخّ
// ترجمة المكتبات «UDT محلّيّ + method» (CE10237)، ويطابق نمط JW_Signals.
// ============================================================================
library("JW_Confluence", overlay = true)

// @function   قيّم إشارةً باتّجاه sigDir مقابل أصوات المصادر.
// @param sigDir     اتّجاه إشارة M-Waves: +1 شراء · -1 بيع.
// @param dirs       اتّجاه كلّ مصدر: +1 صعود · -1 هبوط · 0 حياد.
// @param strengths  قوّة كلّ مصدر (0..2) — تُستعمَل لعتبة الـveto.
// @param criticals  هل المصدر حاسم (معارضته القويّة = veto)؟
// @param useVeto    تفعيل الـveto.
// @returns [agree, oppose, neutral, vetoed]
//   agree   = عدد المصادر الموافقة (dir == sigDir) — هذا «عدد النجوم».
//   oppose  = عدد المصادر المعارِضة (dir == -sigDir).
//   neutral = عدد المصادر المحايدة/غير المتاحة (dir == 0).
//   vetoed  = true إن وُجد مصدر حاسم معارِض بقوّة (strength >= 2).
export f_rate(int sigDir, array<int> dirs, array<float> strengths, array<bool> criticals, bool useVeto) =>
    int agree   = 0
    int oppose  = 0
    int neutral = 0
    bool vetoed = false
    n = array.size(dirs)
    if n > 0 and sigDir != 0
        for i = 0 to n - 1
            d = array.get(dirs, i)
            if d == sigDir
                agree += 1
            else if d == -sigDir
                oppose += 1
                if useVeto and array.get(criticals, i) and array.get(strengths, i) >= 2
                    vetoed := true
            else
                neutral += 1
    [agree, oppose, neutral, vetoed]
