//@version=6
// ============================================================================
// JW_Inducement — إشارة «كنس الإغراء» (IDM) كمصدر استراتيجيّة مُقيَّمة لـM-Waves
// ----------------------------------------------------------------------------
// منطق الإشارة منقول عن:
//   "Inducement Engine Liquidity Targets [MarkitTick]"  © MarkitTick
// اقتباس شخصيّ غير تجاريّ؛ النسب لصاحبه محفوظ.
//
// 🔴 المبدأ (م-إش-3 · نموذج المالك): كلّ استراتيجيّة تُطلِق إشاراتها **باسمها**
//    بأمانتها الكاملة؛ M-Waves تضيف لها **تقييمًا** (نجوم توافق المصادر). هذه
//    المكتبة «تحسب فقط» إشارة IDM (اتّجاه + دخول/وقف/أهداف + موقف) كبيانات صرفة —
//    المؤشّر يرسمها معنونةً «IDM» ويقيّمها. لا رسم/لوحة/webhook هنا.
//
// العقد: بيانات كقيمة · **بلا «UDT محلّيّ + method»** (فخّ الترجمة CE10237) ⇒
//    قائمة الإغراء بمصفوفات موازية صرفة (كنمط JW_Signals/JW_Confluence).
//
// جوهر IDM (نقل حرفيّ): نقطة إغراء = قمّة/قاع سوينغ **بين** آخر قمّة وقاع للبنية.
//   حين يُكنَس الإغراء (السعر يخترقه) ⇒ إشارة **عكسيّة**:
//     • إغراء صاعد يُكنَس هبوطًا (low[1] < سعره) ⇒ **بيع**، الوقف من قمّة شمعته + ATR.
//     • إغراء هابط يُكنَس صعودًا (high[1] > سعره) ⇒ **شراء**، الوقف من قاع شمعته − ATR.
//   الدخول = close[1] · الأهداف TP1/2/3 بنسب R:R. لا look-ahead (كلّ القرارات على
//   الشمعة المُغلَقة السابقة، والـpivots غير مُعيدة الرسم).
// ============================================================================
library("JW_Inducement", overlay = true)

// @function   قمّة سوينغ غير مُعيدة الرسم (المرشّح عند [len]، أعلى ممّا حوله) — نقل f_pivotHigh.
f_pivotHigh(series float src, simple int len) =>
    float candidate = src[len]
    bool  isValid   = true
    for i = 1 to len * 2
        if i != len and src[i] >= candidate
            isValid := false
    isValid ? candidate : na

// @function   قاع سوينغ غير مُعيد الرسم — نقل f_pivotLow.
f_pivotLow(series float src, simple int len) =>
    float candidate = src[len]
    bool  isValid   = true
    for i = 1 to len * 2
        if i != len and src[i] <= candidate
            isValid := false
    isValid ? candidate : na

// @function   إشارة IDM لهذه الشمعة (بيانات صرفة · نقل منطق Inducement Engine).
// @param swingLen   طول اكتشاف السوينغ (افتراض الأصل = 5).
// @param atrLen     طول ATR للوقف المتكيّف (افتراض الأصل = 14).
// @param indMax     سقف ذاكرة نقاط الإغراء (افتراض الأصل = 50).
// @param useAtrSl   الوقف = شمعة الإغراء ± ATR×mult (افتراض true) · مطفأ ⇒ الوقف = شمعة الإغراء فقط.
// @param atrSlMult  مضاعِف ATR للوقف (افتراض 1.0).
// @param rr1        نسبة R:R للهدف الأوّل (افتراض 1.0).
// @param rr2        نسبة R:R للهدف الثاني (افتراض 2.0).
// @param rr3        نسبة R:R للهدف الثالث (افتراض 3.0).
// @returns [dir, entry, sl, tp1, tp2, tp3, trigger, stance]
//   dir: +1 شراء · -1 بيع · 0 لا إشارة هذه الشمعة · trigger: هل أُطلِقت إشارة الآن؟
//   stance: موقف بنية IDM المطلق (+1/-1/0) — للتصويت على إشارات المصادر الأخرى.
export f_inducement(simple int swingLen, simple int atrLen, simple int indMax, simple bool useAtrSl, float atrSlMult, float rr1, float rr2, float rr3) =>
    // ── حالة البنية (نقل MarketStructure + SwingPoint كمتغيّرات صرفة) ──
    var int   msTrend = 0
    var float msHigh  = 0.0
    var float msLow   = 0.0
    // ── قائمة الإغراء (نقل array<InducementPoint> ⇒ مصفوفات موازية) ──
    var array<int>   idmIdx    = array.new<int>()    // بار نقطة الإغراء
    var array<float> idmPrice  = array.new<float>()  // سعرها
    var array<float> idmSL     = array.new<float>()  // قمّة/قاع شمعتها (candle_sl)
    var array<bool>  idmBull   = array.new<bool>()   // إغراء صاعد (قمّة)؟
    var array<bool>  idmBroken = array.new<bool>()   // كُنِس؟
    float atrVal = ta.atr(atrLen)
    // ── سوينغ مؤكَّد + تحديث البنية (نقل حرفيّ) ──
    float ph = f_pivotHigh(high, swingLen)
    float pl = f_pivotLow(low,  swingLen)
    if not na(ph)
        if ph > msHigh
            msHigh := ph
    if not na(pl)
        if pl < msLow or msLow == 0.0
            msLow := pl
    if msTrend == 0 and msHigh != 0.0 and msLow != 0.0    // بذر الاتّجاه الأوّل
        msTrend := 1
    // ── تسجيل نقاط الإغراء: قمّة سوينغ بين القاع والقمّة ⇒ إغراء صاعد · والعكس ──
    if msTrend != 0 and not na(ph)
        if ph < msHigh and ph > msLow
            array.push(idmIdx,    bar_index[swingLen])
            array.push(idmPrice,  ph)
            array.push(idmSL,     high[swingLen])
            array.push(idmBull,   true)
            array.push(idmBroken, false)
    if msTrend != 0 and not na(pl)
        if pl > msLow and pl < msHigh
            array.push(idmIdx,    bar_index[swingLen])
            array.push(idmPrice,  pl)
            array.push(idmSL,     low[swingLen])
            array.push(idmBull,   false)
            array.push(idmBroken, false)
    if array.size(idmIdx) > indMax                         // سقف الذاكرة
        array.shift(idmIdx)
        array.shift(idmPrice)
        array.shift(idmSL)
        array.shift(idmBull)
        array.shift(idmBroken)
    // ── كشف الكنس: إغراء صاعد يُخترَق هبوطًا ⇒ بيع مُهيَّأ · هابط صعودًا ⇒ شراء ──
    bool  bullSwept = false    // إغراء صاعد كُنِس (⇒ إشارة بيع)
    bool  bearSwept = false    // إغراء هابط كُنِس (⇒ إشارة شراء)
    float sweptBullSL = 0.0
    float sweptBearSL = 0.0
    int   sz = array.size(idmIdx)
    if sz > 0
        for i = 0 to sz - 1
            if not array.get(idmBroken, i)
                float ipPrice = array.get(idmPrice, i)
                if array.get(idmBull, i) and low[1] < ipPrice
                    array.set(idmBroken, i, true)
                    bullSwept   := true
                    sweptBullSL := array.get(idmSL, i)
                else if not array.get(idmBull, i) and high[1] > ipPrice
                    array.set(idmBroken, i, true)
                    bearSwept   := true
                    sweptBearSL := array.get(idmSL, i)
    // ── اشتقاق الإشارة: الدخول + الوقف (± ATR) + سلّم الأهداف بالـR:R (نقل حرفيّ) ──
    float entryPrice = close[1]
    bool  shortSig   = bullSwept    // كنس إغراء صاعد ⇒ بيع
    bool  longSig    = bearSwept    // كنس إغراء هابط ⇒ شراء
    int   dir     = 0
    float slOut   = na
    float tp1Out  = na
    float tp2Out  = na
    float tp3Out  = na
    bool  trigger = false
    if shortSig
        float rawSl = useAtrSl ? sweptBullSL + (atrVal * atrSlMult) : sweptBullSL
        float sl    = math.max(rawSl, entryPrice + syminfo.mintick)   // الوقف فوق الدخول قطعًا
        float risk  = sl - entryPrice
        if risk > 0
            dir     := -1
            slOut   := sl
            tp1Out  := entryPrice - (risk * rr1)
            tp2Out  := entryPrice - (risk * rr2)
            tp3Out  := entryPrice - (risk * rr3)
            trigger := true
            msTrend := -1
    else if longSig
        float rawSl = useAtrSl ? sweptBearSL - (atrVal * atrSlMult) : sweptBearSL
        float sl    = math.min(rawSl, entryPrice - syminfo.mintick)   // الوقف تحت الدخول قطعًا
        float risk  = entryPrice - sl
        if risk > 0
            dir     := 1
            slOut   := sl
            tp1Out  := entryPrice + (risk * rr1)
            tp2Out  := entryPrice + (risk * rr2)
            tp3Out  := entryPrice + (risk * rr3)
            trigger := true
            msTrend := 1
    [dir, entryPrice, slOut, tp1Out, tp2Out, tp3Out, trigger, msTrend]
