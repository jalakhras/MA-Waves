//@version=6
// ============================================================================
// JW_Momentum — مصادر تلاقٍ زخميّة (EMA · SMA · VWAP · RSI · دايفرجنس RSI)
// ----------------------------------------------------------------------------
// 🔴 الخطّ الأحمر: النواة (M-Waves) هي المولّد الوحيد للإشارة. هذه المكتبة
//    «تقرأ فقط»: تحسب أصواتًا زخميّة (اتّجاه/veto) لتقييم إشارة ناجية من النواة.
//    لا تولّد نقطة/درجة/منطقة/إشارة، ولا تعدّل أيّها.
//
// العقد (spec_confluence_layer §3): بيانات كقيمة لا وسمًا · بلا UDT-محلّيّ+method
//   (يتفادى فخّ ترجمة المكتبات CE10237) · يطابق نمط JW_SMC/JW_Confluence.
//
// A/B: القيم تطابق مؤشّرات TradingView المدمجة (EMA/SMA/RSI/VWAP) رقميًّا.
//
// [/2] أُضيفت دالّة ثانية f_rsiDivergence (دايفرجنس RSI المنتظم مصوّتًا) — f_momentum
//   **لم تُلمَس** (مصوّتات الزخم القائمة مطابقة بايتًا). RSI مشترك المفهوم ⇒ نفس المكتبة.
// [/3] أُضيفت دالّة ثالثة f_volume (تأكيد المشاركة — داو «الحجم يؤكّد الاتجاه») — f_momentum/f_rsiDivergence
//   **لم تُلمَسا** (A/B للقائم). الحجم يشارك مفهوم VWAP ⇒ نفس المكتبة. spec_confluence_volume.md.
// ============================================================================
library("JW_Momentum", overlay = true)

// @function   أصوات الزخم: السعر فوق/تحت المتوسطات وVWAP + اتّجاه/تشبّع RSI.
//             تُحسَب كلّ بار بلا شرط (ثبات حالة ta) — يقرؤها المؤشّر عند التفعيل.
// @param emaLen  طول المتوسط الأسّيّ (افتراض TradingView = 9؛ نمرّره وسيطًا).
// @param smaLen  طول المتوسط البسيط.
// @param rsiLen  طول RSI.
// @param obThr   عتبة التشبّع الشرائيّ (RSI ≥ ⇒ يمنع مطاردة الشراء).
// @param osThr   عتبة التشبّع البيعيّ (RSI ≤ ⇒ يمنع مطاردة البيع).
// @returns [emaVal, smaVal, vwapVal, rsiVal, emaDir, smaDir, vwapDir, rsiDir, rsiOB, rsiOS]
//   emaVal/smaVal/vwapVal/rsiVal: القيم الخام (يرسمها المؤشّر — خطوط على السعر · RSI في لوحة).
//   emaDir/smaDir/vwapDir: +1 الإغلاق فوق الخطّ · -1 تحته · 0 غير متاح (na/تساوٍ).
//   rsiDir: +1 RSI فوق 50 · -1 تحته · 0 na.
//   rsiOB/rsiOS: هل RSI بلغ التشبّع الشرائيّ/البيعيّ (للـveto في المؤشّر).
export f_momentum(simple int emaLen, simple int smaLen, simple int rsiLen, float obThr, float osThr) =>
    float e = ta.ema(close, emaLen)
    float s = ta.sma(close, smaLen)
    float v = ta.vwap(hlc3)                                         // ⚠ يحتاج أداةً بحجم تداول (US100 يملكه)؛ بلا حجم قد يُرجِع na
    float r = ta.rsi(close, rsiLen)
    int  emaDir  = na(e) ? 0 : close > e ? 1 : close < e ? -1 : 0   // السعر فوق/تحت EMA (حسم المالك: موضع السعر لا ميل الخطّ)
    int  smaDir  = na(s) ? 0 : close > s ? 1 : close < s ? -1 : 0
    int  vwapDir = na(v) ? 0 : close > v ? 1 : close < v ? -1 : 0
    int  rsiDir  = na(r) ? 0 : r > 50 ? 1 : r < 50 ? -1 : 0
    bool rsiOB   = not na(r) and r >= obThr
    bool rsiOS   = not na(r) and r <= osThr
    [e, s, v, r, emaDir, smaDir, vwapDir, rsiDir, rsiOB, rsiOS]

// @function   اتّجاه دايفرجنس RSI المنتظم المصوّت (ملقوط بانقضاء) + النبضة اللحظيّة.
//             نقل حرفيّ لمنطق الدايفرجنس المنتظم من لوحة RSI الأصليّة (نفس منطق JW_RSI):
//               صعوديّ = قاع سعر أدنى + قاع RSI أعلى (Higher Low على المذبذب).
//               هبوطيّ = قمّة سعر أعلى + قمّة RSI أدنى (Lower High على المذبذب).
//             الكشف يكتمل ببيفوت متأخّر (lbR شمعة) ⇒ يُعرَف فقط عند بار الكشف (لا look-ahead).
//             🔴 المشكلة البنيويّة: الدايفرجنس **حدث لحظيّ**، والتقييم يحتاج **صوتًا لكلّ بار** ⇒
//               **لَقْط الاتّجاه** (latch) وإبقاؤه صوتًا حتّى (أ) دايفرجنس معاكس يستبدله، أو
//               (ب) انقضاء holdBars شمعة منذ آخر كشف ⇒ يعود 0. تُحسَب كلّ بار بلا شرط (ثبات ta).
// @param rsiLen   طول RSI (يطابق طول زخم M-Waves = 14).
// @param lbL      بيفوت المذبذب — النظر يسارًا (افتراض الأصل = 5).
// @param lbR      بيفوت المذبذب — النظر يمينًا (افتراض 5؛ به يتأخّر الكشف lbR شمعة — لا look-ahead).
// @param rangeLo  أدنى مدى بين البيفوتين بالشموع (افتراض 5).
// @param rangeHi  أقصى مدى بين البيفوتين بالشموع (افتراض 60).
// @param holdBars كم شمعة يبقى الاتّجاه الملقوط مصوّتًا بعد آخر كشف قبل أن يعود 0.
// @returns [divDir, bullFresh, bearFresh, rsiVal]
//   divDir: +1 دايفرجنس صعوديّ فعّال · -1 هبوطيّ · 0 لا شيء/انقضى.
//   bullFresh/bearFresh: نبضة الكشف اللحظيّة على بار اكتمالها (bool).
//   rsiVal: قيمة RSI الخام (للتحقّق/العرض).
export f_rsiDivergence(simple int rsiLen, simple int lbL, simple int lbR, simple int rangeLo, simple int rangeHi, simple int holdBars) =>
    float r = ta.rsi(close, rsiLen)
    // ── الكشف (نقل حرفيّ · كلّ ta بلا شرط لثبات الحالة) ──
    float rsiLBR = r[lbR]
    bool  plFound = not na(ta.pivotlow(r, lbL, lbR))                    // قاع RSI
    bool  phFound = not na(ta.pivothigh(r, lbL, lbR))                   // قمّة RSI
    float rsiAtPrevPL  = ta.valuewhen(plFound, rsiLBR, 1)              // RSI عند القاع السابق
    float rsiAtPrevPH  = ta.valuewhen(phFound, rsiLBR, 1)              // RSI عند القمّة السابقة
    float lowLBR  = low[lbR]
    float lowAtPrevPL  = ta.valuewhen(plFound, lowLBR, 1)
    float highLBR = high[lbR]
    float highAtPrevPH = ta.valuewhen(phFound, highLBR, 1)
    int   barsSincePl = ta.barssince(plFound[1])                        // [ثبات ta] احسب barssince بلا شرط ثمّ استعمله
    int   barsSincePh = ta.barssince(phFound[1])
    bool  plInRange = rangeLo <= barsSincePl and barsSincePl <= rangeHi
    bool  phInRange = rangeLo <= barsSincePh and barsSincePh <= rangeHi
    bool  rsiHL   = rsiLBR > rsiAtPrevPL and plInRange                  // RSI قاع أعلى
    bool  priceLL = lowLBR < lowAtPrevPL                                // السعر قاع أدنى
    bool  rsiLH   = rsiLBR < rsiAtPrevPH and phInRange                  // RSI قمّة أدنى
    bool  priceHH = highLBR > highAtPrevPH                              // السعر قمّة أعلى
    bool  bullCond = priceLL and rsiHL and plFound                      // دايفرجنس صعوديّ منتظم (نبضة عند الكشف)
    bool  bearCond = priceHH and rsiLH and phFound                      // دايفرجنس هبوطيّ منتظم
    // ── لَقْط الاتّجاه + انقضاء (يحوّل النبضة إلى صوت لكلّ بار) ──
    var int lastDivDir = 0
    var int lastDivBar = na
    if bullCond
        lastDivDir := 1
        lastDivBar := bar_index
    else if bearCond
        lastDivDir := -1
        lastDivBar := bar_index
    int divDir = (not na(lastDivBar) and (bar_index - lastDivBar) <= holdBars) ? lastDivDir : 0
    [divDir, bullCond, bearCond, r]

// @function   تأكيد المشاركة بالحجم (داو: «الحجم يؤكّد الاتجاه») — الحجم النسبيّ + علما «مرتفع/منخفض».
//             الحجم رقم بلا اتجاه ⇒ يصوّت **تأكيدًا** لاتّجاه الإشارة حين المشاركة مرتفعة (حجم فوق متوسّطه)،
//             و**veto** اختياريّ حين منخفضة جدًّا (حركة بلا مشاركة = مشبوهة). يُحسَب كلّ بار (ثبات ta.sma).
//             🔴 المؤشّر يصوّت (المكتبة بيانات فقط). سلاسل volRatio/volHigh/volLow تُقرأ عند بار الإشارة [off] (لا look-ahead).
// @param avgLen   طول متوسّط الحجم (افتراض 20).
// @param mult     عتبة «مرتفع» = الحجم النسبيّ ≥ mult (افتراض 1.5) ⇒ +نجمة لاتّجاه الإشارة.
// @param lowMult  عتبة «منخفض» = الحجم النسبيّ ≤ lowMult (افتراض 0.5) ⇒ veto اختياريّ.
// @returns [vol, volAvg, volRatio, volHigh, volLow]
//   vol: الحجم الخام · volAvg: متوسّطه (SMA) · volRatio: النسبة (vol/avg، na إن لا حجم) · volHigh/volLow: bool.
export f_volume(simple int avgLen, float mult, float lowMult) =>
    float v     = volume
    float avg   = ta.sma(volume, avgLen)
    float ratio = (not na(v) and not na(avg) and avg > 0) ? v / avg : na   // حارس الأدوات بلا حجم ⇒ na ⇒ لا صوت
    bool  hi    = not na(ratio) and ratio >= mult
    bool  lo    = not na(ratio) and ratio <= lowMult
    [v, avg, ratio, hi, lo]
