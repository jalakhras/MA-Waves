//@version=6
// ============================================================================
// JW_SMC — بنية السوق (Smart Money Concepts) كمصدر تلاقٍ لـM-Waves
// ----------------------------------------------------------------------------
// منطق الاتّجاه البنيويّ (BOS / CHoCH ⇒ اتّجاه) منقول عن:
//   "Smart Money Concepts [LuxAlgo]"  © LuxAlgo  —  CC BY-NC-SA 4.0
//   https://creativecommons.org/licenses/by-nc-sa/4.0/
// اقتباس شخصيّ غير تجاريّ؛ النسب لـLuxAlgo محفوظ وفق الرخصة (Attribution).
//
// أُعيدت صياغته بحالة سلاسل صرفة (بلا «UDT محلّيّ + method») ليكون آمنًا داخل
// مكتبة Pine v6 (يتفادى فخّ الترجمة CE10237). الخوارزميّة نفسها حرفًا بحرف.
//
// النطاق: الاتّجاه (internal + swing) + [v2] بيانات رسم بنية BOS/CHoCH + [v3] كشف القمم/القيعان
// المتساوية (EQH/EQL) + [v4] إصلاح تحذيرات ta + [v6] التطرّف الزاحف (Strong/Weak High/Low = trailing extremes)
// + [v8] كتل الطلب (Order Blocks) نقل 100% (سوينغ+داخليّة معًا · شرط internalHigh≠swingHigh · حدّ الشريحة يستبعد
// البار الحاليّ) + [v9] فجوات القيمة العادلة (FVG · عدم توازن 3 شموع + عتبة تلقائيّة + إبطال بالردم)
// + [v10] هندسة مناطق العلاوة/التوازن/الخصم (f_smcPdZones · حساب نقيّ من التطرّف الزاحف) + إخراج ta.cum من الـternary (ثبات)
// + [v11] مستويات MTF (f_smcMtfLevel · قمّة/قاع الفترة الأعلى السابقة عبر request.security + تنقيح بار التطرّف + حارس الفريم)
// + [v12] وسوم HH/HL/LH/LL (f_smcSwingHL · تصنيف نقطة السوينغ الجديدة مقابل سابقتها كـLuxAlgo getCurrentStructure)
// + [v13] 🔴 إصلاح انهيار f_smcMtfLevel على bar 0 (Error: array.slice Index 1 out of bounds): binary_search_rightmost قد
//   يُرجِع فهرسًا = حجم المصفوفة (خارج الحدود) حين قيمة البحث أكبر من كلّ العناصر ⇒ تقييد leftIndex/rightIndex إلى [0..sz] +
//   حارس شريحة غير فارغة. ظهر على تطبيق TradingView (لا المتصفّح) لاختلاف تقييم bar 0. عرض/سلوك مطابق بعد التراكم. —
// المكتبة بيانات فقط، المؤشّر يرسم. (طبقة SMC مكتملة: بنية · EQH/EQL · Strong/Weak · OB · FVG · Premium/Discount · MTF · HH/HL.)
// ============================================================================
library("JW_SMC", overlay = true)

// اتّجاه الـleg خلال `size` شمعة — 1 صعوديّ، 0 هبوطيّ (LuxAlgo: BULLISH_LEG/BEARISH_LEG)
f_leg(simple int size) =>
    var int lg = 0
    newLegHigh = high[size] > ta.highest(size)
    newLegLow  = low[size]  < ta.lowest(size)
    if newLegHigh
        lg := 0
    else if newLegLow
        lg := 1
    lg

// @function            اتّجاه بنية السوق من كسور BOS/CHoCH (swing + internal).
// @param swingSize     طول سوينغ الموجة الكبرى (افتراضيّ LuxAlgo = 50).
// @param internalSize  طول البنية الداخليّة (افتراضيّ LuxAlgo = 5).
// @param confluenceFilter  فلتر «التوافق» للكسور الداخليّة (افتراضيّ LuxAlgo = false).
// @returns  [swingBias, internalBias, swingEvent, internalEvent, swLvl, swPivBar, inLvl, inPivBar, swHigh, swHighBar, swLow, swLowBar]
//   bias   : +1 صعود · -1 هبوط · 0 لا شيء
//   event  : حدث هذه الشمعة — +2 CHoCH صعوديّ · +1 BOS صعوديّ · 0 لا شيء ·
//            -1 BOS هبوطيّ · -2 CHoCH هبوطيّ
//   [v2] swLvl/swPivBar · inLvl/inPivBar : مستوى النقطة المكسورة وبار تكوّنها عند وقوع كسر
//            (na إن لا كسر هذه الشمعة) — يرسم المؤشّر خطًّا من swPivBar إلى الشمعة الحاليّة عند swLvl.
//   [v6] trailTop/trailTopBar · trailBot/trailBotBar : التطرّف الزاحف (أعلى قمّة/أدنى قاع جاريان، يُصفَّران لكلّ نقطة
//            سوينغ جديدة — LuxAlgo updateTrailingExtremes) + بارهما. للرسم Strong/Weak: قمّة قويّة (Strong High) إن
//            swingBias هابط، ضعيفة (Weak High) إن صاعد؛ وبالعكس للقاع. (v5 كان يُرجِع نقطة السوينغ ذاتها — خطأ نقل صُحِّح.)
export f_smcStructure(simple int swingSize, simple int internalSize, bool confluenceFilter) =>
    // ===== نقاط السوينغ (الكبرى) =====
    var float swHigh    = na
    var float swLow     = na
    var int   swHighBar = na          // [v2] بار تكوّن النقطة — للرسم (خطّ من النقطة إلى الكسر)
    var int   swLowBar  = na
    var bool  swHighX   = false
    var bool  swLowX    = false
    var int   swBias    = 0
    // [v6] التطرّفات الزاحفة (Strong/Weak High/Low — LuxAlgo updateTrailingExtremes): أعلى قمّة/أدنى قاع جاريان
    //   يُدفَعان كلّ بار، ويُصفَّران لمستوى كلّ نقطة سوينغ جديدة (نقطة السوينغ = حدّ أدنى، والزحف يتجاوزها حيًّا).
    var float trailTop    = na
    var int   trailTopBar = na
    var float trailBot    = na
    var int   trailBotBar = na
    if na(trailTop) or high > trailTop    // زحف القمّة لأعلى (max الجاري)
        trailTop    := high
        trailTopBar := bar_index
    if na(trailBot) or low < trailBot     // زحف القاع لأسفل (min الجاري)
        trailBot    := low
        trailBotBar := bar_index
    swChg = ta.change(f_leg(swingSize))
    if swChg == +1                    // بدء leg صعوديّ ⇒ تأكّد قاع سوينغ قبل swingSize شمعة
        swLow     := low[swingSize]
        swLowBar  := bar_index - swingSize
        swLowX    := false
        trailBot    := low[swingSize]     // [v6] تصفير القاع الزاحف لقاع السوينغ الجديد (كـLuxAlgo getCurrentStructure)
        trailBotBar := bar_index - swingSize
    else if swChg == -1               // بدء leg هبوطيّ ⇒ تأكّد قمّة سوينغ
        swHigh    := high[swingSize]
        swHighBar := bar_index - swingSize
        swHighX   := false
        trailTop    := high[swingSize]    // [v6] تصفير القمّة الزاحفة لقمّة السوينغ الجديدة
        trailTopBar := bar_index - swingSize
    // ===== النقاط الداخليّة =====
    var float inHigh    = na
    var float inLow     = na
    var int   inHighBar = na          // [v2] بار تكوّن النقطة الداخليّة — للرسم
    var int   inLowBar  = na
    var bool  inHighX   = false
    var bool  inLowX    = false
    var int   inBias    = 0
    inChg = ta.change(f_leg(internalSize))
    if inChg == +1
        inLow     := low[internalSize]
        inLowBar  := bar_index - internalSize
        inLowX    := false
    else if inChg == -1
        inHigh    := high[internalSize]
        inHighBar := bar_index - internalSize
        inHighX   := false
    // فلتر شكل الشمعة للكسور الداخليّة — يطابق تعبير LuxAlgo حرفًا
    bullishBar = confluenceFilter ? (high - math.max(close, open) > math.min(close, open - low)) : true
    bearishBar = confluenceFilter ? (high - math.max(close, open) < math.min(close, open - low)) : true
    // [v4 · إصلاح تحذير ta] احسب التقاطعات **كلّ بار بلا شرط** لثبات حالة ta (كان short-circuit قد يتخطّاها في سلسلة and) ثمّ استعملها في الشروط
    bool inHiCross = ta.crossover(close, inHigh)
    bool inLoCross = ta.crossunder(close, inLow)
    bool swHiCross = ta.crossover(close, swHigh)
    bool swLoCross = ta.crossunder(close, swLow)
    // ===== قلب الاتّجاه الداخليّ (LuxAlgo يعرضه أوّلًا) =====
    int   inEvent  = 0
    float inLvl    = na               // [v2] مستوى النقطة المكسورة + بارها (للرسم عند الكسر)
    int   inPivBar = na
    if not na(inHigh) and inHigh != swHigh and bullishBar and inHiCross and not inHighX
        inEvent  := inBias == -1 ? +2 : +1
        inLvl    := inHigh
        inPivBar := inHighBar
        inHighX  := true
        inBias   := 1
    if not na(inLow) and inLow != swLow and bearishBar and inLoCross and not inLowX
        inEvent  := inBias == 1 ? -2 : -1
        inLvl    := inLow
        inPivBar := inLowBar
        inLowX   := true
        inBias   := -1
    // ===== قلب اتّجاه السوينغ =====
    int   swEvent  = 0
    float swLvl    = na               // [v2] مستوى نقطة السوينغ المكسورة + بارها (للرسم)
    int   swPivBar = na
    if not na(swHigh) and swHiCross and not swHighX
        swEvent  := swBias == -1 ? +2 : +1
        swLvl    := swHigh
        swPivBar := swHighBar
        swHighX  := true
        swBias   := 1
    if not na(swLow) and swLoCross and not swLowX
        swEvent  := swBias == 1 ? -2 : -1
        swLvl    := swLow
        swPivBar := swLowBar
        swLowX   := true
        swBias   := -1
    // [v2] +مستوى/بار النقطة المكسورة لكلّ طبقة (na ما لم يقع كسر هذه الشمعة) — يرسمها المؤشّر
    // [v6] +التطرّف الزاحف (قمّة/قاع) + بارَيهما (Strong/Weak High/Low = trailing extremes كـLuxAlgo — التصنيف بـswBias في المؤشّر)
    [swBias, inBias, swEvent, inEvent, swLvl, swPivBar, inLvl, inPivBar, trailTop, trailTopBar, trailBot, trailBotBar]

// @function  [v3] كشف القمم/القيعان المتساوية (EQH/EQL) — نقطة جديدة ضمن عتبة × ATR من سابقتها (LuxAlgo).
// @param eqLen      طول كشف نقاط التساوي (افتراضيّ LuxAlgo = 3).
// @param threshold  عتبة التساوي (× ATR · افتراضيّ LuxAlgo = 0.1).
// @param atrLen     طول ATR (افتراضيّ LuxAlgo = 200).
// @returns [eqhLvl, eqhFrom, eqhTo, eqlLvl, eqlFrom, eqlTo]
//   عند رصد تساوٍ هذه الشمعة: مستوى النقطة الجديدة + بار السابقة (From) + بار الجديدة (To) — يرسم المؤشّر
//   خطًّا منقّطًا من From إلى To عند المستوى. na إن لا تساوي هذه الشمعة.
export f_smcEqual(simple int eqLen, float threshold, simple int atrLen) =>
    float atr = ta.atr(atrLen)
    var float eqHighLvl = na          // آخر قمّة تساوٍ (المستوى + بارها)
    var int   eqHighBar = na
    var float eqLowLvl  = na
    var int   eqLowBar  = na
    float eqhLvl  = na
    int   eqhFrom = na
    int   eqhTo   = na
    float eqlLvl  = na
    int   eqlFrom = na
    int   eqlTo   = na
    eqChg = ta.change(f_leg(eqLen))
    if eqChg == +1                    // نقطة قاع جديدة
        float nLow = low[eqLen]
        int   nBar = bar_index - eqLen
        if not na(eqLowLvl) and math.abs(eqLowLvl - nLow) < threshold * atr
            eqlLvl  := nLow
            eqlFrom := eqLowBar
            eqlTo   := nBar
        eqLowLvl := nLow
        eqLowBar := nBar
    else if eqChg == -1               // نقطة قمّة جديدة
        float nHigh = high[eqLen]
        int   nBar  = bar_index - eqLen
        if not na(eqHighLvl) and math.abs(eqHighLvl - nHigh) < threshold * atr
            eqhLvl  := nHigh
            eqhFrom := eqHighBar
            eqhTo   := nBar
        eqHighLvl := nHigh
        eqHighBar := nBar
    [eqhLvl, eqhFrom, eqhTo, eqlLvl, eqlFrom, eqlTo]

// [v8] خزّن كتلة طلب: الشمعة الأكثر تطرّفًا بين نقطة السوينغ والكسر (LuxAlgo storeOrdeBlock).
//   bias +1 صعوديّة (أدنى parsedLow) · -1 هبوطيّة (أعلى parsedHigh). الشريحة [pivotBar, bar_index) **تستبعد البار الحاليّ**.
f_obStore(array<float> obT, array<float> obB, array<int> obL, array<int> obS, array<float> pHs, array<float> pLs, int pivotBar, int bias) =>
    float ext    = na
    int   extBar = na
    for b = pivotBar to bar_index - 1
        if b >= 0 and b < array.size(pHs)
            float v = bias == 1 ? array.get(pLs, b) : array.get(pHs, b)
            if na(ext) or (bias == 1 ? v < ext : v > ext)        // أوّل تطرّف (= indexof في LuxAlgo)
                ext    := v
                extBar := b
    if not na(extBar)
        array.unshift(obT, array.get(pHs, extBar))
        array.unshift(obB, array.get(pLs, extBar))
        array.unshift(obL, extBar)
        array.unshift(obS, bias)
        if array.size(obT) > 100                                 // سقف تخزين (LuxAlgo)
            array.pop(obT)
            array.pop(obB)
            array.pop(obL)
            array.pop(obS)

// [v8] أبطِل الكتل التي اخترقها السعر (LuxAlgo deleteOrderBlocks).
f_obMitigate(array<float> obT, array<float> obB, array<int> obL, array<int> obS, float mitBear, float mitBull) =>
    if array.size(obT) > 0
        int di = array.size(obT) - 1
        while di >= 0
            int bz = array.get(obS, di)
            if (bz == -1 and mitBear > array.get(obT, di)) or (bz == 1 and mitBull < array.get(obB, di))
                array.remove(obT, di)
                array.remove(obB, di)
                array.remove(obL, di)
                array.remove(obS, di)
            di -= 1

// @function  [v8] كتل الطلب (Order Blocks) — نقل LuxAlgo **حرفيّ 100%** (getCurrentStructure + storeOrdeBlock + deleteOrderBlocks).
//   يتتبّع **السوينغ والداخليّة معًا** (الداخليّة تشترط `internalHigh ≠ swingHigh` + فلتر الشمعة)، يخزّن كتلة عند
//   كلّ كسر بنيويّ ثمّ يُبطلها حين يخترقها السعر. يُرجِع الطبقة المطلوبة.
// @param swingSize       طول السوينغ (LuxAlgo = 50).
// @param internalSize    طول الداخليّة (LuxAlgo = 5).
// @param internal        الطبقة المُرجَعة: true داخليّة (كـLuxAlgo الظاهر) · false سوينغ.
// @param confluenceFilter فلتر شكل الشمعة للكسور الداخليّة (LuxAlgo افتراض false).
// @param filterMode      "ATR" أو "Range" — مرشّح التذبذب.
// @param mitigationMode  "Close" أو "HighLow" — مصدر الإبطال (LuxAlgo = HighLow).
// @param maxOB           أقصى عدد كتل نشطة تُرجَع (LuxAlgo = 5).
// @returns [obTop, obBot, obLeft, obBias]  الأحدث أوّلًا · obLeft = بار المنشئ · obBias +1/-1.
export f_smcOrderBlocks(simple int swingSize, simple int internalSize, bool internal, bool confluenceFilter, simple string filterMode, simple string mitigationMode, simple int maxOB) =>
    // ===== نقاط السوينغ =====
    var float swHigh  = na
    var float swLow   = na
    var int   swHiBar = na
    var int   swLoBar = na
    var bool  swHiX   = false
    var bool  swLoX   = false
    swChg = ta.change(f_leg(swingSize))
    if swChg == +1
        swLow   := low[swingSize]
        swLoBar := bar_index - swingSize
        swLoX   := false
    else if swChg == -1
        swHigh  := high[swingSize]
        swHiBar := bar_index - swingSize
        swHiX   := false
    // ===== النقاط الداخليّة =====
    var float inHigh  = na
    var float inLow   = na
    var int   inHiBar = na
    var int   inLoBar = na
    var bool  inHiX   = false
    var bool  inLoX   = false
    inChg = ta.change(f_leg(internalSize))
    if inChg == +1
        inLow   := low[internalSize]
        inLoBar := bar_index - internalSize
        inLoX   := false
    else if inChg == -1
        inHigh  := high[internalSize]
        inHiBar := bar_index - internalSize
        inHiX   := false
    // ===== القيم المعالَجة بالتذبذب (parsedHighs/parsedLows) — مفهرَسة بـbar_index =====
    float atr   = ta.atr(200)
    float vol   = filterMode == "ATR" ? atr : ta.cum(ta.tr) / bar_index
    bool  hiVol = (high - low) >= 2 * vol
    var array<float> pHs = array.new<float>()
    var array<float> pLs = array.new<float>()
    array.push(pHs, hiVol ? low : high)
    array.push(pLs, hiVol ? high : low)
    // فلتر شكل الشمعة (LuxAlgo extraCondition للداخليّة)
    bool bullBar = confluenceFilter ? (high - math.max(close, open) > math.min(close, open - low)) : true
    bool bearBar = confluenceFilter ? (high - math.max(close, open) < math.min(close, open - low)) : true
    // التقاطعات (كلّ بار بلا شرط · ثبات حالة ta)
    bool swHiC = ta.crossover(close, swHigh)
    bool swLoC = ta.crossunder(close, swLow)
    bool inHiC = ta.crossover(close, inHigh)
    bool inLoC = ta.crossunder(close, inLow)
    // ===== تخزين كلّ طبقة على حدة =====
    var array<float> iT = array.new<float>()
    var array<float> iB = array.new<float>()
    var array<int>   iL = array.new<int>()
    var array<int>   iS = array.new<int>()
    var array<float> sT = array.new<float>()
    var array<float> sB = array.new<float>()
    var array<int>   sL = array.new<int>()
    var array<int>   sS = array.new<int>()
    // كسور الداخليّة (LuxAlgo يعرضها أوّلًا · شرط internalHigh ≠ swingHigh + فلتر) ⇒ خزّن كتلة داخليّة
    if not na(inHigh) and inHigh != swHigh and bullBar and inHiC and not inHiX
        inHiX := true
        f_obStore(iT, iB, iL, iS, pHs, pLs, inHiBar, 1)
    if not na(inLow) and inLow != swLow and bearBar and inLoC and not inLoX
        inLoX := true
        f_obStore(iT, iB, iL, iS, pHs, pLs, inLoBar, -1)
    // كسور السوينغ (extraCondition = true) ⇒ خزّن كتلة سوينغ
    if not na(swHigh) and swHiC and not swHiX
        swHiX := true
        f_obStore(sT, sB, sL, sS, pHs, pLs, swHiBar, 1)
    if not na(swLow) and swLoC and not swLoX
        swLoX := true
        f_obStore(sT, sB, sL, sS, pHs, pLs, swLoBar, -1)
    // الإبطال (بعد التخزين كـLuxAlgo)
    float mitBear = mitigationMode == "Close" ? close : high
    float mitBull = mitigationMode == "Close" ? close : low
    f_obMitigate(iT, iB, iL, iS, mitBear, mitBull)
    f_obMitigate(sT, sB, sL, sS, mitBear, mitBull)
    // ===== أرجِع الطبقة المطلوبة (أحدث maxOB) =====
    array<float> RT = internal ? iT : sT
    array<float> RB = internal ? iB : sB
    array<int>   RL = internal ? iL : sL
    array<int>   RS = internal ? iS : sS
    array<float> rT = array.new<float>()
    array<float> rB = array.new<float>()
    array<int>   rL = array.new<int>()
    array<int>   rS = array.new<int>()
    int nOut = math.min(maxOB, array.size(RT))
    for i = 0 to (nOut > 0 ? nOut - 1 : 0)
        if i < array.size(RT)
            array.push(rT, array.get(RT, i))
            array.push(rB, array.get(RB, i))
            array.push(rL, array.get(RL, i))
            array.push(rS, array.get(RS, i))
    [rT, rB, rL, rS]

// [v9] فجوات القيمة العادلة (FVG) — نقل LuxAlgo drawFairValueGaps/deleteFairValueGaps (فريم الشارت) حرفيًّا.
//   عدم توازن 3 شموع مُغلَقة: صعوديّة (قاع الحاليّة فوق قمّة ما قبل السابقة) · هبوطيّة (بالعكس) + عتبة تلقائيّة
//   (متوسّط |تغيّر جسم الشمعة%| التراكميّ × 2) + إبطال بالردم. الحالة var داخليّة (تُحسَب كلّ بار — ثبات ta.cum)؛
//   تُرجِع النشطة (نسخ طازجة، الأحدث في المقدّمة). المؤشّر يرسم فقط (صندوقان نصفان لكلّ فجوة).
//   🔴 المعاني كـLuxAlgo: fT=.top · fB=.bottom (هبوطيًّا مقلوبان هندسيًّا)؛ الإبطال يتبع النصّ: صعوديّة low<bottom · هبوطيّة high>top.
// @param autoThreshold  عتبة تلقائيّة (وإلّا 0 = كلّ فجوة).
// @param maxFvg         أقصى عدد نشط (حماية سقف الصناديق المشترَك).
// @returns [fT, fB, fBias, fLeft, fRight] — fBias +1 صعوديّة/-1 هبوطيّة · fLeft/fRight بارا التشكّل.
export f_smcFVG(bool autoThreshold, simple int maxFvg) =>
    var array<float> aT  = array.new<float>()
    var array<float> aB  = array.new<float>()
    var array<int>   aBs = array.new<int>()
    var array<int>   aL  = array.new<int>()
    var array<int>   aR  = array.new<int>()
    float bd  = na(open[1]) ? 0.0 : (close[1] - open[1]) / (open[1] * 100)                 // barDeltaPercent (نقل حرفيّ)
    float cumBd = ta.cum(math.abs(bd))                                                     // [v10] يُحسَب بلا شرط (خارج الـternary) ⇒ ثبات ta على كلّ بار (يُزيل تحذير «ta داخل ternary»)
    float thr = autoThreshold and bar_index > 0 ? cumBd / bar_index * 2 : 0.0
    if barstate.isconfirmed
        if array.size(aT) > 0                                                              // إبطال المردومة (deleteFairValueGaps)
            for i = array.size(aT) - 1 to 0
                if (array.get(aBs, i) == 1 and low < array.get(aB, i)) or (array.get(aBs, i) == -1 and high > array.get(aT, i))
                    array.remove(aT, i)
                    array.remove(aB, i)
                    array.remove(aBs, i)
                    array.remove(aL, i)
                    array.remove(aR, i)
        bool bull = low > high[2] and close[1] > high[2] and bd > thr                       // currentLow>last2High · lastClose>last2High
        bool bear = high < low[2] and close[1] < low[2] and -bd > thr
        if bull
            array.unshift(aT, low)                                                          // top=currentLow · bottom=last2High
            array.unshift(aB, high[2])
            array.unshift(aBs, 1)
            array.unshift(aL, bar_index - 1)
            array.unshift(aR, bar_index)
        if bear
            array.unshift(aT, high)                                                         // top=currentHigh · bottom=last2Low (اسم LuxAlgo)
            array.unshift(aB, low[2])
            array.unshift(aBs, -1)
            array.unshift(aL, bar_index - 1)
            array.unshift(aR, bar_index)
        while array.size(aT) > maxFvg                                                       // حدّ العدد (الأقدم في المؤخّرة)
            int lst = array.size(aT) - 1
            array.remove(aT, lst)
            array.remove(aB, lst)
            array.remove(aBs, lst)
            array.remove(aL, lst)
            array.remove(aR, lst)
    array<float> fT = array.new<float>()                                                   // نسخ طازجة (لا مرجع للحالة الداخليّة)
    array<float> fB = array.new<float>()
    array<int>   fBias = array.new<int>()
    array<int>   fLeft = array.new<int>()
    array<int>   fRight = array.new<int>()
    for i = 0 to (array.size(aT) > 0 ? array.size(aT) - 1 : 0)
        if array.size(aT) > 0
            array.push(fT, array.get(aT, i))
            array.push(fB, array.get(aB, i))
            array.push(fBias, array.get(aBs, i))
            array.push(fLeft, array.get(aL, i))
            array.push(fRight, array.get(aR, i))
    [fT, fB, fBias, fLeft, fRight]

// [v10] هندسة مناطق العلاوة/التوازن/الخصم — نقل LuxAlgo drawPremiumDiscountZones حسابيًّا (نقيّة، صفر حالة، صفر رسم).
//   المدخل = التطرّف الزاحف (trTop/trBot + بارَاه) الذي تُصدِّره f_smcStructure أصلًا ⇒ لا حساب جديد ولا تكرار حالة.
//   العلاوة = أعلى 5% (بيع) · التوازن = 5% حول المنتصف · الخصم = أسفل 5% (شراء). كلّها من قسمة المدى الزاحف كـLuxAlgo.
//   الحارس هنا (لا في المؤشّر): تطرّف غير صالح (na أو مقلوب) ⇒ كلّ المخرجات na ⇒ المؤشّر يتخطّى الرسم. المؤشّر **يرسم فقط**.
// @param trTop/trBot   التطرّف الزاحف (قمّة/قاع). @param trTopB/trBotB بارَا التطرّف. @param lastBar bar_index الحاليّ.
// @returns [pTop, pBot, eTop, eBot, eqLvl, dTop, dBot, zLeft, zMid]
//   pTop/pBot العلاوة · eTop/eBot التوازن + eqLvl مستواه · dTop/dBot الخصم · zLeft يسار الصناديق (أحدث بار سوينغ) · zMid منتصفها (لوسوم العلاوة/الخصم).
export f_smcPdZones(float trTop, float trBot, int trTopB, int trBotB, int lastBar) =>
    float pTop  = na
    float pBot  = na
    float eTop  = na
    float eBot  = na
    float eqLvl = na
    float dTop  = na
    float dBot  = na
    int   zLeft = na
    int   zMid  = na
    if not na(trTop) and not na(trBot) and trTop > trBot and not na(trTopB) and not na(trBotB)
        pTop  := trTop                                                                     // العلاوة: [0.95·قمّة+0.05·قاع .. قمّة]
        pBot  := 0.95 * trTop + 0.05 * trBot
        eTop  := 0.525 * trTop + 0.475 * trBot                                             // التوازن: 5% حول المنتصف
        eBot  := 0.525 * trBot + 0.475 * trTop
        eqLvl := math.avg(trTop, trBot)
        dTop  := 0.95 * trBot + 0.05 * trTop                                               // الخصم: [قاع .. 0.95·قاع+0.05·قمّة]
        dBot  := trBot
        zLeft := math.max(trTopB, trBotB)                                                  // trailing.barIndex = أحدث بار سوينغ
        zMid  := math.round(0.5 * (zLeft + lastBar))
    [pTop, pBot, eTop, eBot, eqLvl, dTop, dBot, zLeft, zMid]

// [v11] مستويات MTF — نقل LuxAlgo drawLevels حرفيًّا (قمّة/قاع الفترة الأعلى **السابقة**): بيانات فقط، المؤشّر يرسم.
//   request.security([high[1],low[1],time[1],time], lookahead_on) = لا إعادة رسم (الفترة السابقة المكتملة). التنقيح = بار
//   التطرّف الفعليّ داخل الفترة (بحث ثنائيّ على مصفوفات الشارت المتراكمة var داخليًّا). الحارس: فريم الشارت أعلى ⇒ valid=false.
//   🔴 request.* مسموح في دوالّ مكتبة Pine v6. كلّ درجة (D/W/M) نداء مستقلّ (مصفوفاته الخاصّة — 3 نداءات security).
// @param tf  الفريم الأعلى ("D"/"W"/"M").
// @returns [valid, topLevel, topTime, botLevel, botTime, rightTime]
//   valid: ارسم؟ (false إن الشارت أعلى) · topLevel/botLevel قمّة/قاع الفترة السابقة · topTime/botTime بارا التطرّف (يسار الخطّ) · rightTime يمين الخطّ (+20 شمعة).
export f_smcMtfLevel(simple string tf) =>
    var array<int>   mtfTimes = array.new<int>()                                            // مصفوفات الشارت المتراكمة (كـLuxAlgo highs/lows/times) — للتنقيح
    var array<float> mtfHighs = array.new<float>()
    var array<float> mtfLows  = array.new<float>()
    mtfTimes.push(time)
    mtfHighs.push(high)
    mtfLows.push(low)
    bool higher = timeframe.in_seconds() > timeframe.in_seconds(tf)                          // فريم الشارت أعلى من tf ⇒ لا رسم (higherTimeframe)
    bool same   = timeframe.in_seconds() == timeframe.in_seconds(tf)                         // نفس الفريم ⇒ الشمعة الحاليّة مباشرةً
    [topLevel, bottomLevel, leftTime, rightTime] = request.security(syminfo.tickerid, tf, [high[1], low[1], time[1], time], lookahead = barmerge.lookahead_on)
    float parsedTop     = same ? high : topLevel
    float parsedBottom  = same ? low : bottomLevel
    int   parsedLeftTime  = same ? time : leftTime
    int   parsedRightTime = same ? time : rightTime
    int   parsedTopTime    = time
    int   parsedBottomTime = time
    if not same
        int sz = mtfTimes.size()
        int leftIndex  = mtfTimes.binary_search_rightmost(parsedLeftTime)                   // شريحة الشارت داخل الفترة السابقة
        int rightIndex = mtfTimes.binary_search_rightmost(parsedRightTime)
        leftIndex  := math.max(0, math.min(leftIndex, sz))                                  // 🔴 [إصلاح حدّيّ] binary_search_rightmost قد يُرجِع sz (خارج الحدود) حين القيمة أكبر من كلّ العناصر (bar 0 · المصفوفة حجمها 1) ⇒ انهيار slice
        rightIndex := math.max(0, math.min(rightIndex, sz))
        if rightIndex > leftIndex                                                            // شريحة غير فارغة وضمن الحدود (from<to≤sz) — وإلّا يبقى parsedTopTime/BottomTime = time (السطران أعلاه)
            array<int>   timeArray   = mtfTimes.slice(leftIndex, rightIndex)
            array<float> topArray    = mtfHighs.slice(leftIndex, rightIndex)
            array<float> bottomArray = mtfLows.slice(leftIndex, rightIndex)
            parsedTopTime    := timeArray.size() > 0 ? timeArray.get(topArray.indexof(topArray.max())) : time      // بار أعلى قمّة/أدنى قاع فعليًّا
            parsedBottomTime := timeArray.size() > 0 ? timeArray.get(bottomArray.indexof(bottomArray.min())) : time
    int  rTime = last_bar_time + 20 * (time - time[1])                                       // يمين الخطّ = آخر بار + 20 شمعة
    bool valid = not higher
    [valid, parsedTop, parsedTopTime, parsedBottom, parsedBottomTime, rTime]

// [v12] وسوم بنية السوق HH/HL/LH/LL — نقل LuxAlgo getCurrentStructure (فرع drawLabel) حرفيًّا: بيانات فقط، المؤشّر يرسم.
//   عند كلّ نقطة سوينغ جديدة (تغيّر leg): قاع جديد ⇒ **LL** إن أدنى من القاع السابق وإلّا **HL** · قمّة جديدة ⇒ **HH** إن أعلى
//   من القمّة السابقة وإلّا **LH**. المقارنة كـLuxAlgo حرفيًّا (na في الأولى ⇒ فرع else = HL/LH). النقطة قبل swingSize شمعة.
//   🔴 f_smcStructure يكشف السوينغ لكن يكتب فوق المستوى (لا يحفظ lastLevel) ⇒ دالّة مستقلّة تحفظ السابق وتصنّف. نفس آلة f_leg.
// @param swingSize  طول السوينغ (نفس smcSwingLen = 50 كـLuxAlgo).
// @returns [code, level, barTime]  code: 0 لا شيء · 1 HH · 2 LH · 3 HL · 4 LL · level مستوى النقطة · barTime بار تكوّنها.
export f_smcSwingHL(simple int swingSize) =>
    var float swHigh     = na
    var float swLow      = na
    var float prevSwHigh = na
    var float prevSwLow  = na
    int   code = 0
    float lvl  = na
    int   barT = na
    swChg = ta.change(f_leg(swingSize))
    if swChg == +1                                                                            // بدء leg صعوديّ ⇒ قاع سوينغ جديد (قبل swingSize شمعة)
        prevSwLow := swLow
        swLow     := low[swingSize]
        lvl  := low[swingSize]
        barT := time[swingSize]
        code := swLow < prevSwLow ? 4 : 3                                                     // LL أدنى من السابق · وإلّا HL (na⇒HL كـLuxAlgo)
    else if swChg == -1                                                                       // بدء leg هبوطيّ ⇒ قمّة سوينغ جديدة
        prevSwHigh := swHigh
        swHigh     := high[swingSize]
        lvl  := high[swingSize]
        barT := time[swingSize]
        code := swHigh > prevSwHigh ? 1 : 2                                                   // HH أعلى من السابق · وإلّا LH (na⇒LH)
    [code, lvl, barT]
