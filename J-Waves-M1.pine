// ══════════════════════════ ط4 · 🟦 المناطق / Zones ══════════════════════════
string grpZone = "ط4 · 🟦 المناطق / Zones"
// ─── قانون التغطية / Coverage law (نقطة مُغطّاة = تطرّف أحدث أكثر تطرّفًا من نوعها) ───
bool   covCur      = input.bool(false, "Coverage: current wave / التغطية: الموجة الحاليّة", group = grpZone, tooltip = "الموجة الحاليّة هي الترند الحيّ ⇒ مطفأة افتراضيًّا (تبقى نقاطها فعّالة). المغطّى غالبًا في الماضي.")
bool   covHist     = input.bool(true, "Coverage: history / التغطية: التاريخ", group = grpZone)
bool   covHoH      = input.bool(false, "Coverage: history-of-history / التغطية: تاريخ التاريخ", group = grpZone, tooltip = "افتراض OFF (قرار المستخدم 2026-07-13): **لا يُطبَّق** قانون التغطية على تاريخ التاريخ ⇒ نقاطه المُغطّاة **تبقى مرسومةً** (متاحة إن احتجناها). شغّله إن أردت إخفاء المغطى القديم.")
// [أ87 · نقل من jaffar v.txt — v2.0.0] استُرجِعت 4 مدخلات المناطق (المنطق القديم الذي رسم صحيحًا): dbgCov · zoneMaxRatio · enableMerge · mergeRatio.
// [تنظيف v2.66.0] dbgCov (تشخيص المغطّى الأحمر المتقطّع) حُذِف — المغطّى يُخفى دائمًا.
float  zoneMaxRatio = input.float(0.25, "Max zone height (× current wave range) / أقصى ارتفاع للمنطقة (× نطاق الموجة)", minval = 0.02, maxval = 1.0, step = 0.01, group = grpZone, tooltip = "يمنع المناطق الكبيرة: ارتفاع المنطقة يجب ألّا يتجاوز هذه النسبة × نطاق الموجة الحاليّة (أعلى-أدنى). أصغر ⇒ مناطق أصغر. (نسبةً لموجات الدفع/التصحيح.)")
bool   enableMerge  = input.bool(true, "Merge close levels into one zone / دمج الخطوط القريبة في منطقة واحدة", group = grpZone, tooltip = "مفعّل: العنقود ينمو بامتصاص كلّ خطّ م.A قريب (ضمن mergeGap) في منطقة واحدة. مطفأ: تزويج ثنائيّ فقط (الأحدث ← أقرب شريك، بلا دمج).")
float  mergeRatio   = input.float(0.05, "Merge-close threshold (× wave range) / عتبة دمج القريبة (× نطاق الموجة)", minval = 0.0, maxval = 0.5, step = 0.01, group = grpZone, tooltip = "عند تفعيل الدمج: المستويات التي الفجوة بينها ≤ هذه النسبة × نطاق الموجة تُدمَج في منطقة واحدة. أكبر ⇒ دمج أكثر. الحدّ الأقصى يبقى zoneMaxRatio.")
float  maLvlMinGapR = input.float(0.005, "Min gap between M.A levels (× wave range) [أ90] / أدنى فجوة بين مستويات م.A (× نطاق الموجة)", minval = 0.0, maxval = 0.1, step = 0.001, group = grpZone, tooltip = "[أ90] مستويا م.A (وبركة المناطق) اللذان الفجوة بينهما ≤ هذه النسبة × نطاق الموجة الحاليّة يُعَدّان **نفس المستوى** ⇒ يُبقى الأوّل ويُسقَط المكرّر. يمنع: خطوط م.A المتراكبة · المناطق المنحلّة (3 نقاط) · الأهداف المكرّرة (TP2≈TP3). 0 = بلا دمج (السلوك السابق).")
bool   anchorCurHoh = input.bool(false, "Anchor zones on current + prior-history only / حصر مرساة المناطق على الحاليّة + تاريخ التاريخ", group = grpZone, tooltip = "[أ89 · اختياريّ] مطفأ (افتراض): المرساة أيّ طبقة (كـjaffar — مناطق عبر كلّ التاريخ، والتاريخ الأقدم يُرسي مناطقه أيضًا). مفعّل: المرساة = الموجة الفعّالة + تاريخ التاريخ فقط؛ التاريخ الأقدم **للاستعارة (شريكًا) لا مرساةً** ⇒ مناطق على البنية الحاليّة فقط (L2-02 «الموجة العاملة»). قارن قبل/بعد.")
bool   showZones   = input.bool(true, "Zones module / وحدة المناطق", group = grpZone)
bool   showZoneLvl = input.bool(true, "M.A level lines / خطوط مستويات م.A", group = grpZone, tooltip = "خطّ أفقيّ على جسم كلّ قمّة/قاع متوسط فعّال: القمّة من أعلى الجسم · القاع من أسفله (الدرس L2-02). الموجة العاملة فقط.")
bool   showZoneBox = input.bool(true, "Zone boxes / مستطيلات المناطق", group = grpZone, tooltip = "مستطيل بين كلّ مستويين متقاربين من نفس المرحلة (قمّتان/قاعان) في الموجة العاملة: greedy الأقرب سعريًّا + منع الاحتواء + منع مستوى ثالث بينهما (الدرس L2-02).")
bool   showCovered = input.bool(true, "Covered pivots (red) / دوائر المغطّى (أحمر)", group = grpZone, tooltip = "حين يكون قانون التغطية مفعّلًا لطبقة النقطة: المغطّى يُلوَّن أحمر إن فُعِّل هذا المفتاح، أو يُخفى إن أُطفئ. لا أثر له إن كان القانون مطفأً (لا تغطية).")
color  cZoneLvl    = input.color(color.new(#D1D4DC, 0), "M.A level / مستويات م.A", group = grpZone)
color  cZoneFill   = input.color(color.new(#2E75B6, 80), "Zone fill (active) / تعبئة المنطقة النشطة", group = grpZone)
color  cZoneBorder = input.color(color.new(#2E75B6, 40), "Zone border / حدّ المنطقة", group = grpZone)
color  cZoneSup    = input.color(color.new(#089981, 82), "Support zone / منطقة الدعم (أخضر)", group = grpZone)
color  cZoneRes    = input.color(color.new(#F23645, 82), "Resistance zone / منطقة المقاومة (أحمر)", group = grpZone)
int    zoneExtend  = input.int(24, "Zone extension (candles) / مدى امتداد المنطقة (شموع)", minval = 0, maxval = 500, group = grpZone)

// ══════════════════════════ ط4 · ✅ الإشارات / Signals ══════════════════════════
string grpSig = "ط4 · ✅ الإشارات / Signals"
bool   enableConf   = input.bool(true, "Enable 4th-degree confirmation / تفعيل تأكيد الرابعة", group = grpSig, tooltip = "كسر آخر قمّة/قاع على فريم أصغر (request.security) ⇒ يرقّي الفرصة القويّة إلى «دخول ✓». ⚠ يعيد الرسم على الشمعة الجارية (طبيعيّ للحظيّ).")
bool   confAuto     = input.bool(true, "Auto TF (>15m→15m · =15m→5m · <15m→1m) / فريم تلقائيّ", group = grpSig, tooltip = "قاعدة الفريم الأصغر: الأساسيّ أكبر من 15د ⇒ التأكيد 15د · يساوي 15د ⇒ 5د · أصغر ⇒ 1د. أطفئه لاختيار فريم يدويّ.")
string confTfManual = input.timeframe("5", "Manual TF (when Auto off) / الفريم اليدويّ (حين الإطفاء)", group = grpSig)
bool   enableAlerts = input.bool(true, "Fire alert on confirmed entry / إطلاق تنبيه عند الدخول المؤكَّد", group = grpSig, tooltip = "يُطلِق alert() عند الفرصة المؤكَّدة (دخول ✓). نوع التنبيه (تطبيق/توست/صوت/إشعار) تختاره في نافذة «Create Alert» في TradingView — Pine يُطلِق الحدث فقط.")
float  minRR        = input.float(1.5, "Min R:R to fire (reward÷risk, 0=off) / أدنى R:R لإطلاق الإشارة (ربح÷خسارة، 0=بلا منع)", minval = 0.0, maxval = 5.0, step = 0.1, group = grpSig, tooltip = "[حسم المالك 2026-07-20: افتراض 1.5 (توازن العدد/الجودة بعد حارس الوقف أ94) — كان 2 «1:2»؛ خُفِّض لأنّ 1:2 أسقط الإشارات الواقعيّة وأبقى المنحلّة، وحارس الوقف أ94 صار يزيل المنحلّة] R:R = الربح المحتمل ÷ الخسارة المحتملة = |الهدف−الدخول| ÷ |الدخول−الوقف|. minRR=1 ⇒ الربح≥الخسارة (1:1) · minRR=2 ⇒ الربح≥ضعف الخسارة (2:1 = «1:2» مخاطرةً/ربحًا). كلّما زاد ⇒ إشارات أقلّ وأفضل. 0 = بلا منع (RR للعرض فقط). يُطبَّق على الحيّة والتاريخيّة.")
string tradeDeg     = input.string("Small / صغيرة", "Trade degree (confirm one finer) / درجة الصفقة (تأكيد بدرجة أنعم)", options = ["Medium / متوسطة", "Small / صغيرة"], group = grpSig, tooltip = "درجة صفقتك تحدّد درجة التأكيد (L2-04): متوسطة ⇐ تأكيد بكسر آخر قمّة/قاع **صغيرة** · صغيرة ⇐ تأكيد بـ**الرابعة** (الفريم الأنعم MTF).")
bool   useMedGate   = input.bool(true, "Entry gate follows trade degree (Medium despair) [G2] / بوّابة اليأس تتبع درجة الصفقة", group = grpSig, tooltip = "[G2 · درس L2-04 «شروط الانعكاس» س30: «اليأس الذي يحدّد الدخول هو يأس الدرجة **المتوسطة**، وليس الصغيرة. الخلط بينهما سيجعلك تدخل مبكّرًا جدًّا» — يؤكّده مصعب3 س75] مفعّل + درجة الصفقة متوسطة ⇒ بوّابة اليأس تُقرأ من **المتوسطة** (phM). درجة الصفقة صغيرة ⇒ من الصغيرة (phS). أطفئه للسلوك السابق (phS دائمًا) للمقارنة قبل/بعد.")
int    confWin      = input.int(200, "Confirmation window (bars) [2-ب] / نافذة تأكيد الكسر (بارات)", minval = 5, maxval = 500, group = grpSig, tooltip = "[2-ب · شروط الانعكاس L2-04] بعد تطرّف داخل منطقة: ابحث عن كسر مؤكِّد لآخر تطرّف معاكس (نفس الدرجة) خلال هذا العدد من البارات. لا كسر ⇒ لا إشارة (نُظهِر المؤكَّد فقط). الكسر يُقرأ على شمعة **مُغلَقة** فقط ⇒ لا إعادة رسم (repaint).")
int    maxTradesL2  = input.int(2, "Max trades per wave (L2) [G-S3] / حدّ صفقات الموجة (م2)", minval = 1, maxval = 5, group = grpSig, tooltip = "[G-S3 · L2-04 س60] المستوى الثاني: صفقتان في المشاركة المتوسطة الواحدة؛ الثالثة+ تُوسَم «م٣ مؤجّل» (تُترك للمستوى الثالث) بدل ✦/⚠. العدّ يُصفَّر بنيويًّا عند تجدّد الموجة.")
float  slBufPts     = input.float(0.0, "SL buffer (× mintick) [م-إش-2أ] / هامش الوقف (× mintick)", minval = 0.0, step = 1.0, group = grpSig, tooltip = "[نموذج المالك · م-إش-2أ] الوقف = حافّة منطقة الدخول (شراء: السفلى − · بيع: العليا +) ± هذا العدد × الحدّ الأدنى للسعر (mintick). 0 = عند الحافّة تمامًا. يُعاير لكلّ أداة (لا رقم سحريّ). للإشارة الحيّة فقط.")
int    numTP        = input.int(3, "Target ladder count TP1..N [م-إش-2أ] / عدد أهداف السلّم", minval = 1, maxval = 5, group = grpSig, tooltip = "[نموذج المالك · م-إش-2أ] عدد أهداف السلّم من خطوط م.A بالاتجاه: TP1 = أوّل مستوى م.A **خارج منطقة الدخول** (L2-03 «مش اللي قدامها»)، ثمّ التالي تباعًا. RR/بوّابة minRR على TP1. إن لا مستوى خارج المنطقة ⇒ لا هدف ⇒ لا إشارة. للحيّة فقط (التاريخيّة بهدف واحد).")
bool   showSignals  = input.bool(true, "Signals (master) / الإشارات (رئيسيّ)", group = grpSig, tooltip = "المفتاح العامّ لكلّ الإشارات. يُغلق الكلّ دفعةً.")
bool   showSigMain  = input.bool(true, "main: live confirmed / الرئيسيّة: الحيّة المؤكَّدة", group = grpSig, tooltip = "الوسم الحيّ للفرصة المؤكَّدة على آخر شمعة (شراء/بيع + RR + وقف/هدف).")
int    sigOppGuard  = input.int(30, "Clear opposite live signal within N bars [أ91] / مسح الإشارة الحيّة المعاكسة خلال N شمعة", minval = 0, maxval = 300, group = grpSig, tooltip = "[أ91 · حسم المالك 2026-07-20] عند إشارة حيّة جديدة تُحذَف الوسوم الحيّة **المعاكسة** التي أُطلِقت خلال آخر N شمعة (أُبطِلت بالانقلاب — ضُرِب وقفها) ⇒ يمنع تكدّس بيع+شراء بنفس المنطقة قرب الانقلاب. 0 = بلا مسح (السلوك السابق).")
bool   sigNeedConc  = input.bool(true, "Signal requires panel decision (conclusions) [أ92] / اشتراط قرار اللوحة (الاستنتاجات) للإشارة", group = grpSig, tooltip = "[أ92 · حسم المالك 2026-07-20] مفعّل (افتراض): الإشارة الحيّة (✦/⚠ + التنبيه) **لا تُطلَق** إلّا إن كان **قرار لوحة القرار** موافقًا (شراء ⇒ القرار «شراء» · بيع ⇒ «بيع»). يُوحّد الإشارة مع الاستنتاجات ⇒ لا إطلاق حين اللوحة «نطاق/انتظار/مراجعة/لا تداول». الشبكة الحيّة (العرض) تبقى مبكّرة. مطفأ = السلوك السابق.")
bool   showSigLevels = input.bool(true, "SL/TP levels grid (live) [م-إش-2ب] / شبكة الوقف/الأهداف (الحيّة)", group = grpSig, tooltip = "[نموذج المالك · م-إش-2ب] شبكة الإشارة الحيّة **الأحدث فقط**: خطوط متقطّعة من الدخول إلى بعد الشمعة الأخيرة (بمقدار «امتداد الشبكة») + وسوم مسعّرة — ✕ الوقف (أحمر) · ▶ الدخول (أزرق) · ● TP1 · ★ TP2 · ◆ TP3 (أخضر). عرض بحت فوق أرقام م-إش-2أ (لا يمسّ إشارة/رقمًا). التاريخيّة تبقى مضغوطة (✦/⚠).")
int    sigLvlExt = input.int(2, "Signal grid extension (candles past last) / امتداد شبكة الإشارة (شموع بعد الأخيرة)", minval = 0, maxval = 200, group = grpSig, tooltip = "[م-إش-2ب] كلّ خطّ (الوقف/الدخول/الأهداف) قطعة متقطّعة من **بار الدخول** إلى **الشمعة الأخيرة + هذا العدد** من الشموع (لا امتداد لا نهائيّ). 2 = شمعتان بعد الأخيرة. عرض بحت.")
bool   showSigSub   = input.bool(true, "sub: historical/degrees / الفرعيّة: التاريخيّة/الدرجات", group = grpSig, tooltip = "الوسوم التاريخيّة عبر الشارت (تطرّفات الدرجات داخل المناطق ✦/⚠ + إشارات الخروج). تحتها مفاتيح الدرجات الثلاث.")
bool   showSigM     = input.bool(true, "medium / المتوسطة", inline = "sigdeg", group = grpSig)
bool   showSigS     = input.bool(true, "small / الصغيرة", inline = "sigdeg", group = grpSig)
bool   showSigExit  = input.bool(true, "Exit signals (break+retest) / إشارات الخروج (كسر+إعادة اختبار)", group = grpSig, tooltip = "«الفرصة الثالثة» (الخروج) بنمط **الكسر ثمّ إعادة الاختبار ثمّ الارتداد** (v2.4.0): (1) السعر يكسر المنطقة بتأكيد (شمعة على >15د · شمعتان على ≤15د). (2) يعود ويلمس الحافّة المكسورة ثمّ يُغلِق ثانيةً خلفها (ارتداد). (3) ✦ **مرّة واحدة** لكلّ منطقة، عند شمعة الارتداد المُغلَقة. لا تكرار بعده. منفصلة عن إشارات الدرجات.")
// [تنظيف v2.66.0 · حسم المالك 2026-07-20] حُذِفت مدخلات **خارج النواة**: showSigDiag (تشخيص) · showSigStats/showSigNotes (تدقيق) · minStopR (أ94) · EMA/SMA/RSI (مؤشّرات أجنبيّة أ95). التقييم الكمّيّ والمؤشّرات يُعادان في طبقة لاحقة (م-إش-3/الاستراتيجية).

// ══════════════════════════ وصفيّ · 🌊 إليوت / Elliott ══════════════════════════
string grpEW       = "وصفيّ · 🌊 إليوت / Elliott"
bool   showEW      = input.bool(false, "Elliott wave-count labels / ترقيم موجات إليوت", group = grpEW, tooltip = "طبقة وصفيّة: ترقيم (1)-(5) دفعة على النقاط الفعّالة لكلّ درجة، فقط إن حقّقت قواعد إليوت الثلاث القطعيّة (فروست/بريكتر). الدرجات متعشّشة (كبيرة⊃متوسطة⊃صغيرة). عرض فقط — لا يمسّ الدرجات/الإشارات/القرار. (a-b-c لاحقًا ⑥-ب.)")
bool   showEWBig   = input.bool(true, "large / الكبيرة", inline = "ewd", group = grpEW)
bool   showEWMed   = input.bool(true, "medium / المتوسطة", inline = "ewd", group = grpEW)
bool   showEWSmall = input.bool(true, "small / الصغيرة", inline = "ewd", group = grpEW)
bool   showEWForm  = input.bool(true, "Forming wave (1?)-(5?) / الموجة الجارية (تنبّؤيّ)", group = grpEW, tooltip = "ترقيم تنبّؤيّ للدفعة الجارية غير المكتملة (بعد آخر دفعة+تصحيح): (1?)-(5?) بلون أفتح — غير مؤكَّدة، تكتمل حين تحقّق قواعد إليوت.")
color  cEWBig      = input.color(#2457E2, "Large color / لون الكبيرة", inline = "ewc", group = grpEW)
color  cEWMed      = input.color(#FF9800, "Medium / المتوسطة", inline = "ewc", group = grpEW)
color  cEWSmall    = input.color(#F23645, "Small / الصغيرة", inline = "ewc", group = grpEW)
int    ewMaxSets   = input.int(0, "Max wave-sets (0=all history) / أقصى دفعات (0=كلّ التاريخ)", minval = 0, group = grpEW, tooltip = "0 = رقّم كلّ الدفعات عبر التاريخ (العدّ من التاريخ). أو آخر N دفعة لتقليل الزحام.")
bool   ewStrict    = input.bool(false, "Strict no-overlap (else allow diagonals) / صارم بلا تراكب (وإلّا يسمح بالقطريّة)", group = grpEW, tooltip = "مطفأ (موصى): يسمح بتراكب الموجة4/الموجة1 = المثلّث القطريّ (Diagonal) — نمط إليوت صحيح (فروست/بريكتر §4-د) ⇒ تظهر الكبيرة والترندات المتراكبة. مفعّل: يفرض ق3 (لا تراكب) ⇒ دفعات دافعة نقيّة فقط (أندر).")
float  ewOffset    = input.float(0.06, "Label offset from pivot (× range) / إزاحة الوسم عن النقطة (× النطاق)", minval = 0.0, step = 0.01, group = grpEW, tooltip = "يرفع الوسم فوق القمّة/تحت القاع بمقدار = هذه النسبة × نطاق سعريّ أصيل، لتفادي تداخله مع الدوائر. كلّ درجة تُزاح خطوة أبعد (تتكدّس النقاط المتقاطعة تحت بعضها بألوانها).")
// [تنظيف v2.66.0] ewDbg (تشخيص أعداد نقاط/وسوم إليوت) حُذِف.

// ═════════════════ 🧠 SMC / Smart Money Concepts (تلاقٍ) [م-إش-3] ═════════════════
// طبقة تلاقي SMC (© LuxAlgo · اقتباس شخصيّ CC BY-NC-SA) — **أسفل إليوت** (حسم المالك). كلّ مصدر خلف مفتاح تفعيل خاصّ (مطفأ افتراضيًّا)
// ⇒ صفر أثر على النواة ما لم يُفعَّل. الترتيب: تصويت/معايير عامّة ← بنية (BOS/CHoCH) ← EQH/EQL ← Strong/Weak ← Order Blocks ← FVG ← Premium/Discount ← MTF ← HH/HL/LH/LL.
string grpConf     = "🧠 SMC / Smart Money Concepts"
bool   smcEnable   = input.bool(true, "Enable SMC structure vote (LuxAlgo) / تفعيل صوت بنية SMC", group = grpConf, tooltip = "[م-إش-3 · حسم المالك: مفعّل افتراضيًّا] اتّجاه بنية السوق (BOS/CHoCH من SMC) يصوّت على إشارة M-Waves — لا يولّدها. عرض فقط (نجوم على الوسم) · لا يمسّ توليد الإشارة (A/B: أطفئه ⇒ الوسم بلا نجوم كما كان).")
int    smcSwingLen = input.int(50, "SMC swing length / طول سوينغ SMC", minval = 10, group = grpConf, tooltip = "طول اكتشاف نقاط السوينغ الكبرى (افتراض LuxAlgo = 50).")
int    smcIntLen   = input.int(5,  "SMC internal length / طول SMC الداخليّ", minval = 3, group = grpConf, tooltip = "طول البنية الداخليّة قصيرة المدى (افتراض LuxAlgo = 5).")
bool   smcConfFilt = input.bool(false, "SMC confluence filter / فلتر توافق SMC", group = grpConf, tooltip = "فلتر شكل الشمعة للكسور الداخليّة (يطابق LuxAlgo · افتراض مطفأ).")
bool   smcCritical = input.bool(true, "SMC opposition = veto / معارضة SMC القويّة تُلغي", group = grpConf, tooltip = "[م-إش-3ب] إن فُعّل: إشارة يعارضها اتّجاه SMC القويّ (BOS/CHoCH طازج معاكس) ⇒ تُوسَم ⛔veto. عرض فقط في هذه المرحلة (لا تُلغى الإشارة تلقائيًّا). مطفأ = SMC صوت عاديّ.")
bool   confUseVeto = input.bool(true,  "Enable veto mark (critical sources) / تفعيل علامة الـveto", group = grpConf, tooltip = "[م-إش-3ب] يحسب علامة ⛔ حين يعارض مصدرٌ حاسم الإشارةَ بقوّة. عرض فقط — لا يغيّر إطلاق الإشارة.")
// ─── [م-إش-3 · دفعة رسوم SMC] رسم بنية BOS/CHoCH — كلّ نوع بمفتاح مستقلّ، مطفأ افتراضيًّا (لا زحام) ───
bool   smcDrawSwing    = input.bool(true, "Draw SMC swing structure (BOS/CHoCH) / رسم بنية SMC السوينغ", group = grpConf, tooltip = "[دفعة الرسوم] خطّ أفقيّ + وسم BOS/CHoCH عند كسر بنية السوينغ (الكبرى). مطفأ افتراضيًّا. حدّ ~50 خطًّا (حماية سقف الرسم المشترَك).")
bool   smcDrawInternal = input.bool(true, "Draw SMC internal structure / رسم بنية SMC الداخليّة", group = grpConf, tooltip = "[دفعة الرسوم] بنية BOS/CHoCH الداخليّة (قصيرة المدى، خطّ متقطّع). مطفأ افتراضيًّا. حدّ ~50 خطًّا.")
color  smcColBull      = input.color(#089981, "SMC bullish structure / بنية SMC صعوديّة", inline = "smcstr", group = grpConf)
color  smcColBear      = input.color(#F23645, "SMC bearish structure / بنية SMC هبوطيّة", inline = "smcstr", group = grpConf)
bool   smcDrawEqual    = input.bool(true, "Draw SMC equal H/L (EQH/EQL) / رسم قمم/قيعان SMC المتساوية", group = grpConf, tooltip = "[دفعة الرسوم · v3] خطّ منقّط + وسم EQH/EQL عند قمّتين/قاعين متقاربين ضمن العتبة (× ATR). مطفأ افتراضيًّا. حدّ ~50.")
int    smcEqualLen     = input.int(3, "SMC equal length / طول كشف التساوي SMC", minval = 1, group = grpConf, tooltip = "طول كشف نقاط التساوي (افتراض LuxAlgo = 3).")
float  smcEqualThresh  = input.float(0.1, "SMC equal threshold (× ATR) / عتبة تساوي SMC (× ATR)", minval = 0.0, step = 0.05, group = grpConf, tooltip = "قمّتان/قاعان ضمن هذه النسبة × ATR(200) ⇒ متساويان (افتراض LuxAlgo = 0.1).")
bool   smcDrawStrongWeak = input.bool(true, "Draw SMC Strong/Weak H/L / رسم قمم/قيعان SMC القويّة/الضعيفة", group = grpConf, tooltip = "[دفعة الرسوم · v5] وسم Strong/Weak High وStrong/Weak Low عند طرفَي السوينغ الحاليّين (يتحرّكان مع البنية): قمّة **قويّة** (bias هابط) صمدت ⇒ مقاومة · **ضعيفة** (bias صاعد) على الأرجح ستُكسَر؛ وبالمثل للقاع. زوج واحد حيّ يُحدَّث كلّ بار (لا تراكم تاريخيّ).")
// ─── [م-إش-3 · دفعة OB · v7] كتل الطلب — تلاقٍ لا زحام: الافتراض يُبرِز مناطقنا فقط (لا صناديق OB عامّة) ───
bool   smcObConfl   = input.bool(true, "OB↔zone confluence (highlight our zones) / تلاقي OB مع مناطقنا", group = grpConf, tooltip = "[دفعة OB] بلا زحام: عند تراكب كتلة طلب SMC مع منطقة استراتيجيّتنا ⇒ (1) كتلة **داخل** المنطقة تمامًا ⇒ مستطيل رماديّ صغير داخلها · (2) كتلة **متراكبة قريبة** (غير محتواة) ⇒ +★ على إشارة المنطقة (صوت تلاقٍ ثانٍ). لا صناديق OB عامّة.")
bool   smcDrawOB    = input.bool(false, "Draw raw SMC order blocks (LuxAlgo) / رسم كتل OB الخام", group = grpConf, tooltip = "[دفعة OB · اختياريّ مطفأ] رسم كلّ كتلة طلب نشطة صندوقًا (كـLuxAlgo) — لمن أراد رؤيتها كاملةً. مطفأ افتراضيًّا (تجنّبًا للزحام). حدّ العدد بـ«عدد كتل OB».")
int    smcObMax     = input.int(5, "Order blocks count / عدد كتل OB", minval = 1, maxval = 20, group = grpConf, tooltip = "أقصى عدد كتل طلب نشطة تُحسَب/تُرسَم (افتراض LuxAlgo = 5).")
bool   smcObInternal = input.bool(true, "OB layer: Internal (else Swing) / طبقة OB: داخليّة (وإلّا سوينغ)", group = grpConf, tooltip = "[v8 · نقل 100%] الطبقة المُستعملة (رسمًا وتلاقيًا): **داخليّة** (طول SMC الداخليّ 5 — افتراض LuxAlgo الظاهر، كتل كثيرة صغيرة مطابِقة) · مطفأ ⇒ **سوينغ** (طول سوينغ 50 — كتل أقلّ أكبر، أنسب لتلاقي مناطقنا الأوسع). الفلتر يتبع «فلتر توافق SMC».")
string smcObFilter  = input.string("ATR", "OB volatility filter / مرشّح تذبذب OB", options = ["ATR", "Range"], group = grpConf, tooltip = "طريقة استبعاد الكتل عالية التذبذب (LuxAlgo: ATR افتراضًا · Range = متوسّط المدى التراكميّ حين قلّة البيانات).")
string smcObMitig   = input.string("HighLow", "OB mitigation source / مصدر إبطال OB", options = ["Close", "HighLow"], group = grpConf, tooltip = "متى تُبطَل الكتلة: الإغلاق خلفها (Close) أو ذيلها (HighLow — افتراض LuxAlgo).")
color  smcColObBull = input.color(color.new(#1848cc, 80), "OB bullish (raw) / كتلة صعوديّة (خام)", inline = "smcob", group = grpConf)
color  smcColObBear = input.color(color.new(#b22833, 80), "OB bearish (raw) / كتلة هبوطيّة (خام)", inline = "smcob", group = grpConf)
color  smcColObZone = input.color(#FFD700, "OB confluence line+stars (gold) / خطّ+نجوم تلاقي OB (ذهبيّ)", group = grpConf, tooltip = "[v9.2] لون الخطّ الذهبيّ المتقطّع الذي يعبُر المنطقة المتلاقية مع OB + النجوم ★ في وسطه (نجمة لكلّ كتلة متراكبة، حدّ 3) — شكل ‪----★★★----‬، بلا زحام.")
// ─── [م-إش-3 · دفعة FVG · v9] فجوات القيمة العادلة — نقل LuxAlgo drawFairValueGaps/deleteFairValueGaps (فريم الشارت) ───
bool   smcDrawFVG   = input.bool(false, "Draw SMC fair value gaps (FVG) / رسم فجوات القيمة العادلة", group = grpConf, tooltip = "[نقل LuxAlgo] عدم توازن 3 شموع (صندوقان نصفان لكلّ فجوة): صعوديّة إن قاع الشمعة الحاليّة فوق قمّة ما قبل السابقة · هبوطيّة بالعكس. مطفأ افتراضيًّا. تُبطَل حين يردم السعر الفجوة (صعوديّة: قاع تحت أسفلها · هبوطيّة: قمّة فوق أعلاها).")
bool   smcFvgAuto   = input.bool(true, "FVG auto threshold / عتبة FVG تلقائيّة", group = grpConf, tooltip = "[نقل LuxAlgo] يرشّح الفجوات غير المهمّة: العتبة = متوسّط |تغيّر جسم الشمعة%| التراكميّ × 2. مطفأ ⇒ كلّ فجوة (عتبة 0).")
int    smcFvgMax    = input.int(12, "FVG max count / أقصى عدد FVG", minval = 1, maxval = 50, group = grpConf, tooltip = "أقصى عدد فجوات نشطة (الأحدث تُبقى). حماية سقف الصناديق المشترَك (300).")
int    smcFvgExtend = input.int(1, "FVG extend (bars) / امتداد FVG (شموع)", minval = 0, maxval = 50, group = grpConf, tooltip = "[نقل LuxAlgo · Extend FVG] كم شمعة يمتدّ صندوق الفجوة يمينًا عن بار تشكّلها.")
color  smcColFvgBull = input.color(color.new(#00ff68, 70), "FVG bullish / FVG صعوديّة", inline = "smcfvg", group = grpConf)
color  smcColFvgBear = input.color(color.new(#ff0008, 70), "FVG bearish / FVG هبوطيّة", inline = "smcfvg", group = grpConf)
// ─── [م-إش-3 · دفعة Premium/Discount · v10] مناطق العلاوة/التوازن/الخصم — الحساب في JW_SMC/10 (f_smcPdZones من التطرّف الزاحف)؛ المؤشّر يرسم فقط ───
bool   smcDrawPD    = input.bool(false, "Draw SMC premium/discount zones / رسم مناطق العلاوة/الخصم", group = grpConf, tooltip = "[نقل LuxAlgo] 3 مناطق تقسم التطرّف الزاحف الحاليّ (نفس مصدر Strong/Weak، بلا حساب جديد): **علاوة** (أعلى 5% ⇒ منطقة بيع) · **توازن** (وسط 5%) · **خصم** (أسفل 5% ⇒ منطقة شراء). SMC كلاسيكيّ: اشترِ من الخصم، بِع من العلاوة. مطفأ افتراضيًّا.")
color  smcColPremium  = input.color(#F23645, "Premium zone / منطقة العلاوة", inline = "smcpd", group = grpConf)
color  smcColEquil    = input.color(color.gray, "Equilibrium / التوازن", inline = "smcpd", group = grpConf)
