float  arrLen    = input.float(0.4, "Small arrow length / طول سهم الصغيرة", minval = 0.1, step = 0.01, group = grpSmall, tooltip = "نسبة من نطاق سعريّ أصيل (لا ATR) — حجم رسم فقط.")
float  arrWidth  = input.float(2.0, "Small arrow width / عرض سهم الصغيرة", minval = 1.0, maxval = 10.0, step = 0.01, group = grpSmall)
string medCircleSize = input.string("Small", "Medium circle size / حجم دائرة المتوسطة", options = ["Fine", "Small", "Normal", "Large", "Huge"], group = grpClM)
string nonEffCircleSize = input.string("Fine", "Non-effective medium size / حجم غير الفعّالة (متوسطة)", options = ["Fine", "Small", "Normal", "Large", "Huge"], group = grpClM)
string largeCircleSize = input.string("Normal", "Large circle size / حجم دائرة الكبيرة", options = ["Fine", "Small", "Normal", "Large", "Huge"], group = grpLarge)
