int    liqWidthM = input.int(2, "Medium liquidity width / عرض سيولة المتوسط", minval = 1, maxval = 8, group = grpLines)
int    liqWidthS = input.int(1, "Small liquidity width / عرض سيولة الصغير", minval = 1, maxval = 8, group = grpLines)
int    levelExtend = input.int(24, "Level extension (candles) / مدى امتداد المستوى (شموع)", minval = 0, maxval = 500, group = grpLines)
