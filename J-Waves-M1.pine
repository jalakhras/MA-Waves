bool   showBroken = input.bool(true, "Broken lines (display) / الخطوط المكسورة (عرض)", group = grpLines, tooltip = "إظهار الخطوط المكسورة متقطّعة (وإلّا تُخفى) — لا يُعتمَد عليها في القرار.")
